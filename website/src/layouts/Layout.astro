---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { url } from "../lib/urls";
import CurrencySwitch from "../components/CurrencySwitch.astro";
import { allowIndexing, representativeEmail } from "../lib/config";
import { site } from "../data/site";
const {
  title = "Titanium bicycles for the road ahead",
  description = "Equator titanium bicycles, carbon wheels and components for Denmark, Sweden and Norway.",
  image = "images/sensei-0.jpg",
  jsonLd,
} = Astro.props;
// Depth of this page below the site root, for relative preview links (see lib/urls.ts).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const below = Astro.url.pathname.slice(base.length).replace(/^\//, "");
const depth = below.split("/").filter(Boolean).length - (below.endsWith(".html") ? 1 : 0);
const root = depth > 0 ? "../".repeat(depth) : "./";
const links = [
  ["Bikes", "bikes/"],
  ["Wheels", "wheels/"],
  ["Accessories", "accessories/"],
  ["About", "about/"],
];
---

<!doctype html>
<html lang="en" data-root={root}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" type="image/svg+xml" href={url("logo.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Equator Scandinavia</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? "index,follow" : "noindex,nofollow"} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={`${title} | Equator`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content={new URL(url(image || "images/sensei-0.jpg"), Astro.site)}
    />
    <meta property="og:site_name" content="Equator Scandinavia" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header-shell">
    <div class="wrap site-header">
      <a href={url()} aria-label="Equator home">
        <img src={url("logo.svg")} width="143" height="28" alt="Equator" />
      </a>
      <nav aria-label="Main navigation">
        {links.map(([label, path]) => (
          <a href={url(path)} aria-current={below === path ? "page" : below.startsWith(path) ? "true" : undefined}>{label}</a>
        ))}
      </nav>
      <div class="header-actions">
        <a href={url("contact/")}>Contact</a>
        <CurrencySwitch id="currency-desktop" />
        <a href={url("cart/")} class="bag-link">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
          <span class="visually-hidden">Bag, items:</span>
          <span class="bag-count" data-cart-count>0</span>
        </a>
        <details class="mobile-menu">
          <summary aria-label="Menu">
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
          </summary>
          <div class="drawer">
            {[...links, ["Contact", "contact/"]].map(([label, path]) => (
              <a href={url(path)}>{label}</a>
            ))}
            <div class="drawer-currency">
              <span>Currency</span>
              <CurrencySwitch id="currency-mobile" />
            </div>
          </div>
        </details>
      </div>
    </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a href={url()}>
              <img
                src={url("logo.svg")}
                width="143"
                height="28"
                alt="Equator"
              />
            </a>
            <p style="max-width:260px;font-size:14px;margin-top:12px">
              Titanium bicycles.
              <br />A different way forward.
            </p>
          </div>
          <div>
            <h2 class="footer-title">Explore</h2>
            {links.slice(0, 3).map(([label, path]) => (
              <a href={url(path)}>{label}</a>
            ))}
          </div>
          <div>
            <h2 class="footer-title">Equator & support</h2>
            {[
              ["About", "about"],
              ["Contact", "contact"],
              ["Warranty", "warranty"],
              ["Crash replacement", "crash-replacement"],
              ["Shipping & delivery", "shipping"],
              ["FAQ", "faq"],
            ].map(([label, path]) => (
              <a href={url(path + "/")}>{label}</a>
            ))}
          </div>
          <div>
            <h2 class="footer-title">Information</h2>
            {[
              ["Privacy", "privacy"],
              ["Terms & conditions", "terms"],
              ["Cookie information", "cookies"],
            ].map(([label, path]) => (
              <a href={url(path + "/")}>{label}</a>
            ))}
          </div>
        </div>
        <div class="footer-bottom bar">
          <span>© 2026 Equator Scandinavia · Representing Equator Cycling, Czech Republic</span>
          {site.showEmail ? <span>{representativeEmail}</span> : <a href={url("contact/")}>Contact us</a>}
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  import { updateCount } from "../lib/storage";
  import { activeCurrency, currencyKey, fromPrice, money } from "../lib/catalog";
  // Show build-time EUR prices in the visitor's chosen currency.
  const currency = activeCurrency();
  if (currency !== "EUR")
    document.querySelectorAll<HTMLElement>("[data-fx-note]").forEach((el) => (el.hidden = false));
  if (currency !== "EUR")
    document.querySelectorAll<HTMLElement>("[data-eur]").forEach((el) => {
      const amount = el.dataset.eur === "" ? null : Number(el.dataset.eur);
      el.textContent = el.dataset.prefix ? fromPrice(amount, el.dataset.prefix) : money(amount);
    });
  document.querySelectorAll<HTMLSelectElement>("[data-currency-switch]").forEach((select) => {
    select.value = currency;
    select.addEventListener("change", () => {
      try {
        localStorage.setItem(currencyKey, select.value);
      } catch {
        /* storage unavailable: keep EUR */
      }
      location.reload();
    });
  });
  updateCount();
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  // Feedback: the bag count gives a small bump when something is added.
  window.addEventListener("cartchange", () => {
    updateCount();
    if (reduceMotion) return;
    document.querySelectorAll<HTMLElement>("[data-cart-count]").forEach((el) =>
      el.animate(
        [{ transform: "scale(1)" }, { transform: "scale(1.3)" }, { transform: "scale(1)" }],
        { duration: 280, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
      ),
    );
  });
  // Scroll reveal for [data-reveal]; siblings get a short stagger via --i.
  document.querySelectorAll<HTMLElement>("[data-reveal-group]").forEach((group) =>
    [...group.children].forEach((child, i) => (child as HTMLElement).style.setProperty("--i", String(i % 6))),
  );
  const revealables = document.querySelectorAll<HTMLElement>("[data-reveal], [data-reveal-group] > *");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add("in");
          io.unobserve(e.target);
        }),
      { rootMargin: "0px 0px -8% 0px" },
    );
    revealables.forEach((el) => io.observe(el));
  } else revealables.forEach((el) => el.classList.add("in"));
  window.addEventListener("storage", updateCount);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape")
      document
        .querySelectorAll<HTMLDetailsElement>(".mobile-menu")
        .forEach((menu) => (menu.open = false));
  });
</script>
