---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { url } from "../lib/urls";
const {
  title = "Titanium bicycles for the road ahead",
  description = "Explore Equator titanium bicycles and carbon wheels. A Scandinavian storefront prototype.",
  image = "images/sensei-0.jpg",
  jsonLd,
} = Astro.props;
const links = [
  ["Bikes", "bikes/"],
  ["Wheels", "wheels/"],
  ["Accessories", "accessories/"],
  ["About", "about/"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={url("logo.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Equator Scandinavia</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={`${title} — Equator`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content={new URL(url(image || "images/sensei-0.jpg"), Astro.site)}
    />
    <meta property="og:site_name" content="Equator Scandinavia" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="notice">
      SCANDINAVIA / PROTOTYPE — Explore a build. No orders or messages are sent.
    </div>
    <header class="wrap site-header">
      <a href={url()} aria-label="Equator home">
        <img src={url("logo.svg")} width="143" height="28" alt="Equator" />
      </a>
      <nav aria-label="Main navigation">
        {links.map(([label, path]) => (
          <a href={url(path)}>{label}</a>
        ))}
      </nav>
      <div class="header-actions">
        <a href={url("contact/")}>Contact</a>
        <a href={url("cart/")} class="bag-link">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
          <span class="visually-hidden">Bag, items:</span>
          <span class="bag-count" data-cart-count>0</span>
        </a>
        <details class="mobile-menu">
          <summary aria-label="Menu">
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
          </summary>
          <div class="drawer">
            {[...links, ["Contact", "contact/"]].map(([label, path]) => (
              <a href={url(path)}>{label}</a>
            ))}
          </div>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a href={url()}>
              <img
                src={url("logo.svg")}
                width="143"
                height="28"
                alt="Equator"
              />
            </a>
            <p style="max-width:260px;font-size:14px;margin-top:25px">
              Titanium bicycles.
              <br />A different way forward.
            </p>
            <span class="eyebrow">Czech roots. Northern horizons.</span>
          </div>
          <div>
            <h3>Explore</h3>
            {links.slice(0, 3).map(([label, path]) => (
              <a href={url(path)}>{label}</a>
            ))}
          </div>
          <div>
            <h3>Equator & support</h3>
            {[
              ["About", "about"],
              ["Contact", "contact"],
              ["Warranty", "warranty"],
              ["Crash replacement", "crash-replacement"],
              ["Shipping & delivery", "shipping"],
              ["FAQ", "faq"],
            ].map(([label, path]) => (
              <a href={url(path + "/")}>{label}</a>
            ))}
          </div>
          <div>
            <h3>Information</h3>
            {[
              ["Privacy", "privacy"],
              ["Terms & conditions", "terms"],
              ["Cookie information", "cookies"],
            ].map(([label, path]) => (
              <a href={url(path + "/")}>{label}</a>
            ))}
            <p style="font-size:12px">Prototype policies await approval.</p>
          </div>
        </div>
        <div class="footer-bottom bar">
          <span>© 2026 Equator Scandinavia · Website prototype</span>
          <span>Designed for the road ahead.</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  import { updateCount } from "../lib/storage";
  updateCount();
  window.addEventListener("cartchange", updateCount);
  window.addEventListener("storage", updateCount);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape")
      document
        .querySelectorAll<HTMLDetailsElement>(".mobile-menu")
        .forEach((menu) => (menu.open = false));
  });
</script>
