---
import Layout from "../layouts/Layout.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { url } from "../lib/urls";
---

<Layout title="Review your inquiry">
  <div class="wrap section">
    <p class="eyebrow">Request your build</p>
    <h1>
      Let’s talk
      <br />
      about your ride.
    </h1>
    <div class="checkout">
      <div>
        <p class="intro">
          Send your build as an inquiry. We'll review it, confirm price,
          availability and delivery with Equator, and reply by email. Nothing
          is charged now.
        </p>
        <InquiryForm />
      </div>
      <aside>
        <h2>Your selection</h2>
        <div id="inquiry-lines"></div>
        <p id="inquiry-total" class="price"></p>
        <p class="caption">
          Estimated manufacturer reference prices. Shipping and final prices
          are confirmed with you before payment.
        </p>
        <a class="text-link" href={url("cart/")}>
          Edit your bag ↗
        </a>
      </aside>
    </div>
  </div>
</Layout>
<script>
  import { readCart } from "../lib/storage";
  import { resolve, totals, money } from "../lib/catalog";
  const host = document.querySelector("#inquiry-lines")!;
  try {
    const lines = readCart();
    if (!lines.length)
      host.textContent =
        "Your bag is empty. Add a product to preview an inquiry.";
    for (const line of lines) {
      const p = document.createElement("p");
      const product = resolve(line);
      p.textContent = `${line.quantity} × ${product.name} — ${product.description} — ${money(product.price)}`;
      host.append(p);
    }
    const t = totals(lines);
    document.querySelector("#inquiry-total")!.textContent = t.unknown
      ? `${money(t.subtotal)} + items priced on request`
      : money(t.subtotal);
  } catch {
    host.textContent =
      "Your saved bag could not be read. Return to your bag to reset it.";
  }
</script>
<style>
  .checkout {
    display: grid;
    grid-template-columns: 1.1fr 0.8fr;
    gap: 80px;
    margin-top: 45px;
  }
  .checkout aside {
    background: #f7f7f7;
    padding: 30px;
    align-self: start;
  }
  .checkout aside h2 {
    font-size: 30px;
  }
  .caption {
    font-size: 12px;
  }
  @media (max-width: 767px) {
    .checkout {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .checkout aside {
      grid-row: 1;
    }
  }
</style>
