---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { bikes as families } from "../data/bikes/catalog";
import WheelCard from "../components/WheelCard.astro";
import Photo from "../components/Photo.astro";
import { wheels } from "../data/wheels/catalog";
import { url } from "../lib/urls";
const featuredWheels = ["wavy-35", "wavy-50", "gravel-ultimate-40"]
  .map((id) => wheels.find((w) => w.id === id))
  .filter((w) => w !== undefined);
---

<Layout>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="eyebrow">Equator titanium / Made for the ride</p>
      <h1>Built to <br class="desktop-break" />go further.</h1>
      <p>
        Titanium bicycles. Thoughtfully designed.
        <br />
        For wherever the road takes you.
      </p>
      <div class="hero-actions">
        <a class="button" href={url("bikes/")}>
          Explore our bikes
        </a>
        <a class="text-link" href={url("about/")}>Discover Equator</a>
      </div>
    </div>
    <div class="hero-photo">
      <Photo
        src="images/sensei-0.jpg"
        alt="Equator Sensei Gen 4 titanium gravel bicycle beside an open field"
        eager
      />
      <div class="photo-caption">
        <span>01 / SENSEI GEN 4</span>
        <a href={url("bikes/sensei-gen-4/")}>Meet your next ride</a>
      </div>
    </div>
  </section>
  <div class="wrap principles">
    <span>DESIGNED IN CZECHIA</span>
    <span>TITANIUM AT HEART</span>
    <span>BUILT AROUND YOUR RIDE</span>
  </div>
  <section class="wrap section">
    <div class="bar collection-heading">
      <div>
        <p class="eyebrow">The titanium collection</p>
        <h2>
          Three ways.
          <br />
          Your way.
        </h2>
      </div>
      <p>
        From the everyday escape to the road less ridden.
        <br />
        Find the Equator that feels like you.
      </p>
    </div>
    <div class="grid3">
      {families.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>
  <section class="titanium section">
    <div class="wrap story-grid">
      <div>
        <p class="eyebrow">A material with character</p>
        <h2>
          Less about the next.
          <br />
          More about the lasting.
        </h2>
      </div>
      <div>
        <p>
          Titanium brings corrosion resistance and a distinctive, understated
          finish. Frame design, tyres and the complete build shape how a bicycle
          feels on the road.
        </p>
        <p>For us, the appeal is simple: a bicycle you want to keep riding.</p>
        <a class="text-link" href={url("about/#titanium")}>
          Why titanium
        </a>
      </div>
    </div>
  </section>
  <section class="wrap section">
    <div class="bar collection-heading">
      <div>
        <p class="eyebrow">Equator carbon wheels</p>
        <h2>
          Carbon, considered.
        </h2>
      </div>
      <p>
        Carbon wheels for road, gravel and time trial, assembled and tested by
        hand in Zlín, Czech Republic.
      </p>
    </div>
    <div class="grid3">
      {featuredWheels.map((w) => <WheelCard wheel={w} />)}
    </div>
    <a class="text-link" href={url("wheels/")} style="margin-top:32px">
      All wheels
    </a>
  </section>
  <section class="brand section">
    <div class="wrap story-grid">
      <div>
        <p class="eyebrow">The people behind Equator</p>
        <h2>
          A small company.
          <br />
          A personal approach.
        </h2>
      </div>
      <div>
        <p>
          Equator is a Czech cycling company working with titanium frames and
          carbon wheels. Its bicycles are designed, tested and assembled in
          Czechia, with parts sourced from specialist suppliers worldwide.
        </p>
        <p>
          Equator Scandinavia brings these bikes to riders in Denmark, Sweden
          and Norway, with a personal conversation about every build.
        </p>
        <a class="text-link" href={url("about/")}>Our story</a>
      </div>
    </div>
  </section>
  <section class="closing">
    <div class="wrap">
      <p class="eyebrow">Czech roots. Northern horizons.</p>
      <h2>Find your next ride.</h2>
      <p>Start with a bicycle. Make it your own.</p>
      <a class="button" href={url("bikes/")}>
        Explore the collection
      </a>
    </div>
  </section>
</Layout>
<style>
  .hero {
    display: grid;
    grid-template-columns: 0.85fr 1.35fr;
    min-height: 630px;
    align-items: center;
    gap: 48px;
    padding-block: 64px;
  }
  .hero h1 {
    margin-bottom: 28px;
  }
  .hero-copy > p:not(.eyebrow) {
    font-size: 16px;
    margin-bottom: 32px;
  }
  .hero-photo {
    min-width: 0;
  }
  .hero-photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .photo-caption {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.08em;
    padding: 20px 0;
  }
  .principles {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
    padding-block: 24px;
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .collection-heading {
    margin-bottom: 48px;
    align-items: flex-end;
  }
  .collection-heading p {
    font-size: 14px;
  }
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
  }
  .titanium {
    background: #f5f5f2;
  }
  .story-grid p {
    max-width: 460px;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .brand {
    border-top: 1px solid #e5e5e5;
  }
  .closing {
    text-align: center;
    background: #f7f7f7;
    padding: 90px 0;
  }
  .closing h2 {
    font-size: clamp(3rem, 6vw, 6rem);
  }
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 44px;
      gap: 40px;
      min-height: 0;
    }
    .hero h1 {
      font-size: clamp(2rem, 8.4vw, 4rem);
      letter-spacing: -0.045em;
    }
    .desktop-break {
      display: none;
    }
    .principles {
      gap: 12px;
      font-size: 8px;
      line-height: 1.6;
    }
    .collection-heading {
      display: block;
    }
    .story-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .photo-caption {
      font-size: 9px;
    }
    .closing {
      padding: 60px 0;
    }
  }
</style>
