---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/urls";
import Photo from "../components/Photo.astro";
// Background film: Equator's own "Equator Titanium Manufacturing" (owner-supplied
// file), re-encoded to 960×540 without sound. Wording follows Equator's site:
// frames designed and tested in the Czech Republic; 20 years of carbon wheels
// ("20 let výroby karbonových zapletených kol", equator-cycling.com/o-nas, checked 23 Oct 2026).
const points = [
  {
    title: "Designed in Zlín",
    text: "Every angle, tube length, diameter and profile is decided in-house.",
  },
  {
    title: "Tested, then tested again",
    text: "Each frame is refined over several prototypes, ridden on a test track in the Ore Mountains.",
  },
  {
    title: "Built to keep",
    text: "Titanium doesn't corrode and needs no paint. Wet roads and salted winters won't make it rust.",
  },
];
---

<Layout
  title="About Equator"
  description="A small family company from Zlín, Czech Republic, designing and testing titanium bikes, with 20 years of experience in carbon wheels."
  image="images/sensei-2.jpg"
>
  <section class="hero" aria-labelledby="about-title">
    <video
      class="hero-video"
      data-film
      muted
      loop
      playsinline
      preload="metadata"
      poster={url("video/titanium-manufacturing-poster.jpg")}
      aria-hidden="true"
    >
      <source src={url("video/titanium-manufacturing-540.mp4")} type="video/mp4" />
    </video>
    <div class="wrap hero-copy">
      <h1 id="about-title">About Equator</h1>
      <p>A small family company in Zlín, Czech Republic, designing titanium bikes and carbon wheels.</p>
    </div>
    <button type="button" class="film-toggle" data-film-toggle aria-pressed="false" hidden>
      <span data-film-label>Pause film</span>
    </button>
  </section>

  <section class="wrap statement" data-reveal>
    <p>
      Twenty years of building carbon wheels taught Equator a feel for detail.
      Titanium frames were the logical next step.
    </p>
  </section>

  <section class="wrap points" id="titanium" data-reveal-group>
    {points.map((p) => (
      <div>
        <h2>{p.title}</h2>
        <p>{p.text}</p>
      </div>
    ))}
  </section>

  <figure class="wrap wide" data-reveal>
    <Photo
      src="images/sensei-2.jpg"
      alt="Equator Sensei Gen 4 titanium bicycle on a gravel track between fields"
      sizes="100vw"
    />
  </figure>

  <section class="wrap closing" data-reveal>
    <h2>Now in Scandinavia.</h2>
    <p>
      Equator Scandinavia brings these bikes and wheels to riders and shops in
      Denmark, Sweden and Norway, starting in Copenhagen. Every request is
      answered personally.
    </p>
    <div class="actions">
      <a class="button" href={url("bikes/")}>Explore the bikes</a>
      <a class="text-link" href={url("contact/")}>Get in touch</a>
    </div>
  </section>
</Layout>

<script>
  // Background film: muted, on repeat, only while on screen. No autoplay for
  // reduced motion or Save-Data; the button pauses or plays it.
  const video = document.querySelector<HTMLVideoElement>("[data-film]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-film-toggle]");
  if (video && toggle) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    let wanted = !reduce && !saveData;
    const label = toggle.querySelector<HTMLElement>("[data-film-label]")!;
    const sync = () => {
      toggle.setAttribute("aria-pressed", String(video.paused));
      label.textContent = video.paused ? "Play film" : "Pause film";
    };
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    toggle.hidden = false;
    sync();
    toggle.addEventListener("click", () => {
      wanted = video.paused;
      if (wanted) video.play().catch(() => {});
      else video.pause();
    });
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && wanted) video.play().catch(() => {});
      else if (!e.isIntersecting) video.pause();
    }, { threshold: 0.2 }).observe(video);
  }
</script>

<style>
  /* Hero: the film fills the first screen, text sits bottom left on a soft fade. */
  .hero {
    position: relative;
    height: min(86vh, 860px);
    min-height: 480px;
    overflow: hidden;
    background: #111;
    color: #fff;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.12) 50%, rgba(0, 0, 0, 0.05));
    pointer-events: none;
  }
  .hero-copy {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: clamp(32px, 6vw, 80px);
  }
  .hero-copy h1 {
    color: #fff;
    margin-bottom: 16px;
  }
  .hero-copy p {
    max-width: 30rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--fs-lead);
  }
  .film-toggle {
    position: absolute;
    z-index: 1;
    right: clamp(18px, 3vw, 40px);
    bottom: clamp(32px, 6vw, 80px);
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.25);
    color: #fff;
    font-size: var(--fs-label);
    transition: background-color var(--dur-ui) ease, border-color var(--dur-ui) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .film-toggle:hover {
      background: rgba(0, 0, 0, 0.5);
      border-color: #fff;
    }
  }
  .film-toggle:focus-visible {
    outline-color: #fff;
  }

  .statement {
    padding: clamp(96px, 12vw, 176px) 0 clamp(64px, 8vw, 112px);
  }
  .statement p {
    max-width: 24ch;
    margin: 0;
    color: #171717;
    font-size: clamp(1.75rem, 3.6vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
  }
  .points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(96px, 12vw, 176px);
  }
  .points h2 {
    font-size: var(--fs-lead);
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 10px;
  }
  .points p {
    max-width: 32ch;
    margin: 0;
  }
  .wide {
    margin: 0 auto clamp(96px, 12vw, 176px);
  }
  .wide :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .closing {
    max-width: 40rem;
    padding-bottom: clamp(96px, 12vw, 176px);
    text-align: center;
  }
  .closing p {
    margin: 0 auto;
    font-size: var(--fs-lead);
  }
  .actions {
    display: flex;
    gap: 28px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  @media (max-width: 767px) {
    .hero {
      height: 78vh;
      min-height: 440px;
    }
    .hero-copy {
      bottom: 92px;
    }
    .film-toggle {
      left: 18px;
      right: auto;
      bottom: 28px;
    }
    .points {
      grid-template-columns: 1fr;
    }
    .wide :global(img) {
      aspect-ratio: 4 / 3;
    }
    .closing p {
      font-size: var(--fs-body);
    }
  }
</style>
