---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/urls";
import Photo from "../components/Photo.astro";
// Equator's own film "Equator Titanium Manufacturing" (owner-supplied file),
// re-encoded to 960×540 without sound for a quiet looping background.
---

<Layout
  title="About Equator"
  description="A small family company from Zlín: twenty years of hand-built carbon wheels, and titanium bikes developed, tested and assembled in the Czech Republic."
  image="images/sensei-2.jpg"
>
  <div class="wrap about">
    <h1 data-reveal>About</h1>

    <section class="split" data-reveal-group>
      <div class="copy">
        <h2>Twenty years of wheels. Then titanium.</h2>
        <p>
          Equator is a small family company from Zlín, in the Czech Republic.
          For twenty years it has built carbon wheels by hand. Titanium frames
          were the logical next step.
        </p>
        <p>
          The idea is simple: a bike you keep for years, not just a few
          seasons.
        </p>
      </div>
      <figure>
        <Photo
          src="images/sensei-2.jpg"
          alt="Equator Sensei Gen 4 titanium bicycle on a gravel track between fields"
          sizes="(max-width: 767px) 100vw, 45vw"
          eager
        />
      </figure>
    </section>

    <section class="film" aria-labelledby="film-title" data-reveal>
      <video
        class="film-video"
        data-film
        muted
        loop
        playsinline
        preload="none"
        poster={url("video/titanium-manufacturing-poster.jpg")}
        aria-hidden="true"
      >
        <source src={url("video/titanium-manufacturing-540.mp4")} type="video/mp4" />
      </video>
      <div class="film-copy">
        <h2 id="film-title">Made in the Czech Republic.</h2>
        <p>Equator develops, tests and assembles its titanium bikes at home.</p>
      </div>
      <button type="button" class="film-toggle" data-film-toggle aria-pressed="false" hidden>
        <span data-film-label>Pause film</span>
      </button>
    </section>

    <section class="split flip" data-reveal-group>
      <figure>
        <Photo
          src="images/raiden-6.jpg"
          alt="Titanium bottom bracket shell and chainstays of an Equator Raiden"
          sizes="(max-width: 767px) 100vw, 45vw"
        />
      </figure>
      <div class="copy">
        <h2>Tested where it's rough.</h2>
        <p>
          Equator designs every geometry itself, then refines it over a series
          of prototypes, ridden on a test track in the Ore Mountains until the
          ride is right.
        </p>
        <p>
          Supple and comfortable where it should be. Stiff and direct where it
          counts.
        </p>
      </div>
    </section>

    <section class="split" id="titanium" data-reveal-group>
      <div class="copy">
        <h2>Made for wet roads and long winters.</h2>
        <p>
          Titanium doesn't corrode and doesn't change its properties, so the
          frames need no paint. Rain, grit and salted winter roads won't make it
          rust. Scratches become part of the bike's story.
        </p>
        <p>
          The wheels follow the same thinking: built and tested by hand in Zlín,
          with Sapim CX-Ray spokes and Enduro sealed bearings.
        </p>
      </div>
      <figure>
        <Photo
          src="images/yasei-1.jpg"
          alt="Equator Yasei titanium adventure bike on a gravel road"
          sizes="(max-width: 767px) 100vw, 45vw"
        />
      </figure>
    </section>

    <section class="closing" data-reveal>
      <h2>Now in Scandinavia.</h2>
      <p>
        Equator Scandinavia brings these bikes and wheels to riders and shops in
        Denmark, Sweden and Norway, starting in Copenhagen. Every request is
        answered personally, and price and delivery are confirmed before
        anything is paid.
      </p>
      <div class="actions">
        <a class="button" href={url("bikes/")}>Explore the bikes</a>
        <a class="text-link" href={url("contact/")}>Get in touch</a>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Background film: plays muted on repeat while on screen. It doesn't start for
  // visitors who prefer reduced motion or save data; the button pauses or plays it.
  const video = document.querySelector<HTMLVideoElement>("[data-film]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-film-toggle]");
  if (video && toggle) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    let wanted = !reduce && !saveData;
    const label = toggle.querySelector<HTMLElement>("[data-film-label]")!;
    const sync = () => {
      const playing = !video.paused;
      toggle.setAttribute("aria-pressed", String(!playing));
      label.textContent = playing ? "Pause film" : "Play film";
    };
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    toggle.hidden = false;
    sync();
    toggle.addEventListener("click", () => {
      wanted = video.paused;
      if (wanted) video.play().catch(() => {});
      else video.pause();
    });
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && wanted) video.play().catch(() => {});
      else if (!e.isIntersecting) video.pause();
    }, { threshold: 0.25 }).observe(video);
  }
</script>

<style>
  .about {
    padding: 72px 0 120px;
  }
  .about h1 {
    margin: 0 0 56px;
  }
  .about h2 {
    font-size: clamp(1.75rem, 2.8vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .about p {
    font-size: var(--fs-lead);
    line-height: 1.6;
    margin: 0 0 14px;
  }
  figure {
    margin: 0;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: center;
    padding-bottom: clamp(96px, 12vw, 180px);
  }
  .split .copy {
    max-width: 30rem;
  }
  .split.flip .copy {
    justify-self: start;
  }
  .split :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .film {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    max-height: 82vh;
    width: 100%;
    margin: 0 0 clamp(96px, 12vw, 180px);
    background: #111;
    color: #fff;
  }
  .film-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Darkens the lower part so the text stays readable on every frame. */
  .film::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.1) 55%, rgba(0, 0, 0, 0));
    pointer-events: none;
  }
  .film-copy {
    position: absolute;
    z-index: 1;
    left: clamp(20px, 4vw, 56px);
    bottom: clamp(20px, 4vw, 56px);
    max-width: 40rem;
  }
  .film-copy h2 {
    color: #fff;
    margin-bottom: 12px;
  }
  .about .film-copy p {
    color: rgba(255, 255, 255, 0.86);
    margin: 0;
  }
  .film-toggle {
    position: absolute;
    z-index: 1;
    right: clamp(12px, 3vw, 40px);
    bottom: clamp(16px, 4vw, 56px);
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.25);
    color: #fff;
    font-size: var(--fs-label);
    transition: background-color var(--dur-ui) ease, border-color var(--dur-ui) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .film-toggle:hover {
      background: rgba(0, 0, 0, 0.5);
      border-color: #fff;
    }
  }
  .film-toggle:focus-visible {
    outline-color: #fff;
  }
  .closing {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }
  .actions {
    display: flex;
    gap: 28px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  @media (max-width: 767px) {
    .about {
      padding: 40px 0 80px;
    }
    .about h1 {
      margin-bottom: 32px;
    }
    .split {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 72px;
    }
    .split.flip figure {
      order: 0;
    }
    .split:not(.flip) figure {
      order: -1;
    }
    .film {
      aspect-ratio: 4 / 5;
      max-height: none;
      margin-bottom: 72px;
    }
    .film-copy {
      right: 20px;
      bottom: 84px;
    }
    .film-toggle {
      left: 20px;
      right: auto;
      bottom: 20px;
    }
    .about p {
      font-size: var(--fs-body);
    }
  }
</style>
