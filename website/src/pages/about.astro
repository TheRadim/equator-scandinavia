---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/urls";
import Photo from "../components/Photo.astro";
// Equator's own film on its YouTube channel ("Equator Titanium Manufacturing", 0:30).
const videoId = "CEZV7_N_ev4";
---

<Layout
  title="About Equator"
  description="A small family company from Zlín: twenty years of hand-built carbon wheels, and titanium bikes developed, tested and assembled in the Czech Republic."
  image="images/sensei-2.jpg"
>
  <div class="wrap about">
    <h1 data-reveal>About</h1>

    <section class="split" data-reveal-group>
      <div class="copy">
        <h2>Twenty years of wheels. Then titanium.</h2>
        <p>
          Equator is a small family company from Zlín, in the Czech Republic.
          For twenty years it has built carbon wheels by hand. Titanium frames
          were the logical next step.
        </p>
        <p>
          The idea is simple: a bike you keep for years, not just a few
          seasons.
        </p>
      </div>
      <figure>
        <Photo
          src="images/sensei-2.jpg"
          alt="Equator Sensei Gen 4 titanium bicycle on a gravel track between fields"
          sizes="(max-width: 767px) 100vw, 45vw"
          eager
        />
      </figure>
    </section>

    <section class="film" aria-labelledby="film-title" data-reveal>
      <div class="video" data-video={videoId}>
        <button type="button" class="video-play" aria-label="Play the film: how an Equator titanium frame is made, 30 seconds, from YouTube">
          <Photo
            src="images/raiden-5.jpg"
            alt=""
            sizes="(max-width: 767px) 100vw, 70vw"
          />
          <span class="play" aria-hidden="true"></span>
        </button>
      </div>
      <h2 id="film-title">Made in the Czech Republic.</h2>
      <p>
        Equator develops, tests and assembles its titanium bikes at home. Thirty
        seconds from the workshop.
      </p>
    </section>

    <section class="split flip" data-reveal-group>
      <figure>
        <Photo
          src="images/raiden-6.jpg"
          alt="Titanium bottom bracket shell and chainstays of an Equator Raiden"
          sizes="(max-width: 767px) 100vw, 45vw"
        />
      </figure>
      <div class="copy">
        <h2>Tested where it's rough.</h2>
        <p>
          Equator designs every geometry itself, then refines it over a series
          of prototypes, ridden on a test track in the Ore Mountains until the
          ride is right.
        </p>
        <p>
          Supple and comfortable where it should be. Stiff and direct where it
          counts.
        </p>
      </div>
    </section>

    <section class="split" id="titanium" data-reveal-group>
      <div class="copy">
        <h2>Made for wet roads and long winters.</h2>
        <p>
          Titanium doesn't corrode and doesn't change its properties, so the
          frames need no paint. Rain, grit and salted winter roads won't make it
          rust. Scratches become part of the bike's story.
        </p>
        <p>
          The wheels follow the same thinking: built and tested by hand in Zlín,
          with Sapim CX-Ray spokes and Enduro sealed bearings.
        </p>
      </div>
      <figure>
        <Photo
          src="images/yasei-1.jpg"
          alt="Equator Yasei titanium adventure bike on a gravel road"
          sizes="(max-width: 767px) 100vw, 45vw"
        />
      </figure>
    </section>

    <section class="closing" data-reveal>
      <h2>Now in Scandinavia.</h2>
      <p>
        Equator Scandinavia brings these bikes and wheels to riders and shops in
        Denmark, Sweden and Norway, starting in Copenhagen. Every request is
        answered personally, and price and delivery are confirmed before
        anything is paid.
      </p>
      <div class="actions">
        <a class="button" href={url("bikes/")}>Explore the bikes</a>
        <a class="text-link" href={url("contact/")}>Get in touch</a>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Click-to-play: nothing loads from YouTube until the visitor asks for the film.
  document.querySelectorAll<HTMLElement>("[data-video]").forEach((box) => {
    box.querySelector("button")?.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.video}?autoplay=1&rel=0&playsinline=1`;
      frame.title = "Equator Titanium Manufacturing (YouTube)";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      box.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .about {
    padding: 72px 0 120px;
  }
  .about h1 {
    margin: 0 0 56px;
  }
  .about h2 {
    font-size: clamp(1.75rem, 2.8vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .about p {
    font-size: var(--fs-lead);
    line-height: 1.6;
    margin: 0 0 14px;
  }
  figure {
    margin: 0;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: center;
    padding-bottom: clamp(96px, 12vw, 180px);
  }
  .split .copy {
    max-width: 30rem;
  }
  .split.flip .copy {
    justify-self: start;
  }
  .split :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .film {
    max-width: 960px;
    margin: 0 auto;
    padding-bottom: clamp(96px, 12vw, 180px);
    text-align: center;
  }
  .film h2 {
    margin-top: 40px;
  }
  .film p {
    max-width: 34rem;
    margin-inline: auto;
  }
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #111;
    overflow: hidden;
  }
  .video :global(iframe),
  .video-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: none;
  }
  .video-play :global(picture),
  .video-play :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-play :global(img) {
    filter: brightness(0.82);
    transition: transform var(--dur-photo) var(--ease-out), filter var(--dur-ui) ease;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 76px;
    height: 76px;
    margin: -38px 0 0 -38px;
    border-radius: 50%;
    background: #fff;
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .play::after {
    content: "";
    position: absolute;
    left: 31px;
    top: 26px;
    border-style: solid;
    border-width: 12px 0 12px 19px;
    border-color: transparent transparent transparent #171717;
  }
  .video-play:active .play {
    transform: scale(0.96);
  }
  @media (hover: hover) and (pointer: fine) {
    .video-play:hover :global(img) {
      transform: scale(1.03);
      filter: brightness(0.72);
    }
    .video-play:hover .play {
      transform: scale(1.06);
    }
  }
  .closing {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }
  .actions {
    display: flex;
    gap: 28px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-play :global(img),
    .play {
      transition: filter var(--dur-ui) ease;
    }
    .video-play:hover :global(img),
    .video-play:hover .play,
    .video-play:active .play {
      transform: none;
    }
  }
  @media (max-width: 767px) {
    .about {
      padding: 40px 0 80px;
    }
    .about h1 {
      margin-bottom: 32px;
    }
    .split {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 72px;
    }
    .split.flip figure {
      order: 0;
    }
    .split:not(.flip) figure {
      order: -1;
    }
    .film {
      padding-bottom: 72px;
    }
    .film h2 {
      margin-top: 28px;
    }
    .about p {
      font-size: var(--fs-body);
    }
    .play {
      width: 60px;
      height: 60px;
      margin: -30px 0 0 -30px;
    }
    .play::after {
      left: 24px;
      top: 20px;
      border-width: 10px 0 10px 16px;
    }
  }
</style>
