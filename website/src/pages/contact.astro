---
import Layout from "../layouts/Layout.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { liveInquiries, representativeEmail } from "../lib/config";
---

<Layout title="Contact">
  <section class="wrap section">
    <p class="eyebrow">A personal conversation</p>
    <h1>
      What’s your
      <br />
      next ride?
    </h1>
    <div class="contact">
      <div>
        <p>
          Bicycles, wheels, a custom build or a possible partnership. A good
          place to start is a conversation.
        </p>
        <h3>Service region</h3>
        <p>Denmark · Sweden · Norway</p>
        <h3>We can help with</h3>
        <p>
          Bicycle and wheelset inquiries · custom builds · dealer partnerships ·
          warranty support · general questions
        </p>
        {
          representativeEmail ? (
            <>
              <h3>Email</h3>
              <p>
                <a class="text-link" href={`mailto:${representativeEmail}`}>
                  {representativeEmail}
                </a>
              </p>
            </>
          ) : (
            <p class="caption">Direct contact details will be published at launch.</p>
          )
        }
        {!liveInquiries && (
          <p class="caption">
            This form currently runs in demo mode and does not send messages.
          </p>
        )}
      </div>
      <InquiryForm kind="contact" />
    </div>
  </section>
</Layout>
<style>
  .contact {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 100px;
    padding-top: 40px;
  }
  .contact h3 {
    margin-top: 40px;
  }
  @media (max-width: 767px) {
    .contact {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
