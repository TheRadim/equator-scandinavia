---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/urls";
---

<Layout title="Inquiry received" description="Confirmation of your Equator Scandinavia inquiry." noindex>
  <section class="wrap section confirm">
    <p class="eyebrow" data-eyebrow>Inquiry received</p>
    <h1 data-title>Thanks for your inquiry.</h1>
    <p class="lead" data-lead>
      We'll review your configuration, confirm availability and pricing, and
      get back to you.
    </p>
    <div class="receipt" data-receipt hidden>
      <div class="receipt-head">
        <span>Reference</span>
        <strong data-reference></strong>
      </div>
      <p class="caption" data-time></p>
      <div data-lines></div>
      <div class="receipt-total" data-total-row hidden>
        <span>Estimated total</span><span data-total></span>
      </div>
      <p class="caption">
        Nothing has been charged. We'll send you a written confirmation of
        price, availability and delivery before you order.
      </p>
    </div>
    <p data-empty hidden>
      There's no recent inquiry in this browser session.
    </p>
    <div class="actions">
      <a class="button" href={url("bikes/")}>Continue exploring</a>
      <a class="text-link" href={url("cart/")} data-bag-link hidden>Return to your bag</a>
    </div>
  </section>
</Layout>
<script>
  import { money, totalLabel } from "../lib/catalog";
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  type Receipt = {
    sent?: boolean;
    kind: "order" | "contact";
    reference: string;
    timestamp: string;
    items: { quantity: number; name: string; description: string; price: number | null }[];
    totals: { subtotal: number; unknown: boolean };
  };
  let data: Receipt | null = null;
  try {
    data = JSON.parse(sessionStorage.getItem("equator-inquiry-receipt") || "null");
  } catch {
    data = null;
  }
  if (!data) {
    $("[data-empty]").hidden = false;
    $("[data-lead]").hidden = true;
    $("[data-title]").textContent = "Nothing to confirm yet.";
  } else {
    if (data.kind === "contact") {
      $("[data-title]").textContent = "Thanks for getting in touch.";
      $("[data-lead]").textContent = "Your message has been received. We'll reply by email.";
    }
    $("[data-receipt]").hidden = false;
    $("[data-reference]").textContent = data.reference;
    $("[data-time]").textContent = `Submitted ${new Date(data.timestamp).toLocaleString("en-GB", { dateStyle: "long", timeStyle: "short" })}`;
    const host = $("[data-lines]");
    for (const item of data.items ?? []) {
      const row = document.createElement("div");
      row.className = "receipt-line";
      const left = document.createElement("div");
      const name = document.createElement("strong");
      name.textContent = `${item.quantity} × ${item.name}`;
      const desc = document.createElement("p");
      desc.className = "caption";
      desc.textContent = item.description;
      left.append(name, desc);
      const price = document.createElement("span");
      price.textContent = money(item.price);
      row.append(left, price);
      host.append(row);
    }
    if (data.items?.length) {
      $("[data-total-row]").hidden = false;
      $("[data-total]").textContent = totalLabel(data.totals);
    }
  }
</script>
<style>
  .confirm .lead {
    max-width: 620px;
    font-size: 18px;
  }
  .receipt {
    max-width: 680px;
    background: #f7f7f7;
    padding: 28px;
    margin: 36px 0;
  }
  .receipt-head {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
  }
  .receipt :global(.receipt-line) {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 14px 0;
    border-bottom: 1px solid #e5e5e5;
    font-size: 14px;
  }
  .receipt :global(.receipt-line p) {
    margin: 4px 0 0;
  }
  .receipt-total {
    display: flex;
    justify-content: space-between;
    padding: 16px 0 8px;
    font-size: 16px;
  }
  .actions {
    display: flex;
    gap: 28px;
    align-items: center;
    flex-wrap: wrap;
  }
</style>
