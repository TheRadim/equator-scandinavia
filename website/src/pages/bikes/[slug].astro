---
import Layout from "../../layouts/Layout.astro";
import Configurator from "../../components/Configurator.astro";
import { bikes } from "../../data/bikes/catalog";
import { url } from "../../lib/urls";
export function getStaticPaths() {
  return bikes.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
const { product } = Astro.props;
---

<Layout title={product.name} description={product.description}>
  <div class="wrap">
    <div class="breadcrumbs">
      <a href={url("bikes/")}>Bikes</a> / {product.name}
    </div>
    <div class="product-layout">
      <div>
        <img
          class="main-photo"
          src={url(product.image)}
          alt={`${product.name}, illustrative complete bicycle`}
          width="1024"
          height="768"
        />
        <p class="caption">
          Illustrative complete build. A frameset does not include all pictured
          components.
        </p>
        <details>
          <summary>Frame & build details</summary>
          <dl>
            {Object.entries(product.specs).map(([key, value]) => (
              <div>
                <dt>{key}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </details>
        <details id="size-guide">
          <summary>Size guide</summary>
          <p>
            Currently listed selectable sizes: {product.sizes.join(", ")}. Fit
            depends on your measurements and riding position.
          </p>
          <a class="text-link" href={`${product.builds[0].source}#description`}>
            View manufacturer geometry ↗
          </a>
          <p class="caption">
            A geometry-table entry does not establish that size is currently
            available.
          </p>
        </details>
      </div>
      <div>
        <p class="eyebrow">{product.category} / Titanium</p>
        <h1>{product.name}</h1>
        <p>{product.description}</p>
        <p class="price">
          From{" "}
          {new Intl.NumberFormat("en-IE", {
            style: "currency",
            currency: "EUR",
            maximumFractionDigits: 0,
          }).format((product.builds[0].price ?? 0) / 100)}
        </p>
        <p class="caption">
          Manufacturer reference price, checked 16 October 2026.
          <br />
          Scandinavian pricing and delivery to be confirmed.
        </p>
        <hr />
        <Configurator product={product} />
        <hr />
        <p class="caption">{product.availability}</p>
      </div>
    </div>
  </div>
</Layout>
<style>
  .breadcrumbs {
    font-size: 12px;
    color: #666;
    padding: 30px 0;
  }
  .product-layout {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 70px;
    padding: 20px 0 90px;
  }
  .main-photo {
    width: 100%;
    height: auto;
    background: #f7f7f7;
  }
  .caption {
    font-size: 12px;
    line-height: 1.6;
  }
  .product-layout h1 {
    font-size: clamp(3rem, 4.5vw, 5rem);
  }
  details {
    border-top: 1px solid #ddd;
    padding: 22px 0;
  }
  summary {
    cursor: pointer;
    font-size: 14px;
    min-height: 24px;
  }
  details p {
    margin-top: 20px;
  }
  dl > div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 13px;
    border-bottom: 1px solid #eee;
    padding: 15px 0;
  }
  dd {
    text-align: right;
    margin: 0;
    color: #666;
  }
  @media (max-width: 767px) {
    .product-layout {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .breadcrumbs {
      padding: 24px 0;
    }
    .product-layout {
      padding-top: 0;
    }
  }
</style>
