---
import Layout from "../../layouts/Layout.astro";
import Configurator from "../../components/Configurator.astro";
import Gallery from "../../components/Gallery.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { bikes, type Product } from "../../data/bikes/catalog";
import { money } from "../../lib/catalog";
import { productJsonLd } from "../../lib/seo";
import { url } from "../../lib/urls";
export function getStaticPaths() {
  return bikes.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
const { product } = Astro.props as { product: Product };
const prices = product.builds
  .map((b) => b.price)
  .filter((p): p is number => p !== null);
const from = prices.length ? Math.min(...prices) : null;
const verified = new Date(product.verified).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const geometrySource = product.builds[0].source;
---

<Layout
  title={`${product.name} titanium ${product.category.split("·")[0].trim().toLowerCase()} bike`}
  description={`Equator ${product.name}: ${product.description} Configure a frameset or complete build and request it.`}
  image={product.images[0]}
  jsonLd={productJsonLd({
    name: `Equator ${product.name}`,
    description: product.description,
    image: product.images[0],
    path: `bikes/${product.slug}/`,
  })}
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={url("bikes/")}>Bikes</a> / {product.name}
    </nav>
    <div class="product-layout">
      <div class="product-media">
        <Gallery
          images={product.images}
          alt={`Equator ${product.name} titanium bicycle, illustrative complete build`}
          label={product.name}
          caption="Illustrative complete build. A frameset does not include the pictured components."
        />
      </div>
      <div class="product-info">
        <p class="eyebrow">{product.category} / Titanium</p>
        <h1>{product.name}</h1>
        <p class="lead">{product.description}</p>
        <p class="price">{from === null ? "Price on request" : `From ${money(from)}`}</p>
        <div class="availability">
          <StatusBadge status={product.inventoryStatus} />
          <p class="caption">
            {product.availability}. Reference prices checked {verified}.
          </p>
        </div>
        <hr />
        <Configurator product={product} />
        <div class="product-details">
          <details class="disclosure">
            <summary>Frame details</summary>
            <dl class="specs">
              {
                Object.entries(product.specs).map(([key, value]) => (
                  <div>
                    <dt>{key}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              }
              <div><dt>Listed sizes</dt><dd>{product.sizes.join(", ")}</dd></div>
            </dl>
          </details>
          <details class="disclosure" id="size-guide">
            <summary>Size guide</summary>
            <p>
              Currently selectable sizes: {product.sizes.join(", ")}. The right
              size depends on your measurements and riding position — tell us
              your height and inseam in your inquiry and we'll help you choose.
            </p>
            <p class="caption">
              Equator's geometry table may list sizes that are not currently
              offered. We don't republish geometry until it is confirmed.
            </p>
            <a class="text-link" href={geometrySource} rel="noopener">
              Manufacturer geometry ↗
            </a>
          </details>
          <details class="disclosure">
            <summary>How ordering works</summary>
            <p>
              Adding to your bag isn't a purchase. Send your build as an
              inquiry and we'll confirm price, availability and delivery with
              Equator before anything is paid.
            </p>
          </details>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .product-details {
    margin-top: 36px;
  }
</style>
