---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/urls";
---

<Layout title="Your bag">
  <section class="wrap section">
    <p class="eyebrow">Your next ride starts here</p>
    <h1>Your bag.</h1>
    <p>
      This is an inquiry, not a purchase. Final prices and availability are
      confirmed personally.
    </p>
    <p id="cart-error" class="error" role="alert"></p>
    <button id="reset-cart" class="button light" hidden>
      Reset unreadable bag
    </button>
    <div id="cart-lines"></div>
    <div id="cart-empty" class="empty" hidden>
      <h3>Your next adventure is waiting.</h3>
      <p>
        Explore a bicycle, choose your factory build and add it to your bag.
      </p>
      <a class="button" href={url("bikes/")}>
        Explore bikes ↗
      </a>
    </div>
    <div id="cart-summary" hidden>
      <hr />
      <div class="bar">
        <div>
          <p>Reference estimate</p>
          <p class="price" id="cart-total"></p>
          <p class="muted" id="cart-unknown"></p>
        </div>
        <a class="button" href={url("inquiry/")}>
          Review inquiry ↗
        </a>
      </div>
      <p style="font-size:12px">
        Manufacturer reference prices in EUR. Shipping, local pricing and
        current availability require confirmation.
      </p>
    </div>
    <a class="text-link" href={url("bikes/")} style="margin-top:30px">
      Continue exploring
    </a>
    <noscript>
      <p>JavaScript is required to view the locally saved bag.</p>
    </noscript>
  </section>
</Layout>
<script>
  import { readCart, writeCart } from "../lib/storage";
  import { resolve, money, totals } from "../lib/catalog";
  import { url } from "../lib/urls";
  const host = document.querySelector<HTMLElement>("#cart-lines")!,
    error = document.querySelector<HTMLElement>("#cart-error")!,
    reset = document.querySelector<HTMLButtonElement>("#reset-cart")!;
  function render() {
    try {
      const lines = readCart();
      host.replaceChildren();
      error.textContent = "";
      reset.hidden = true;
      document.querySelector<HTMLElement>("#cart-empty")!.hidden =
        lines.length > 0;
      document.querySelector<HTMLElement>("#cart-summary")!.hidden =
        !lines.length;
      lines.forEach((line, index) => {
        const product = resolve(line);
        const article = document.createElement("article");
        article.className = "cart-line";
        let image: HTMLElement;
        if (product.image) {
          const img = new Image();
          img.src = url(product.image);
          img.alt = product.name;
          img.width = 200;
          img.height = 150;
          image = img;
        } else {
          image = document.createElement("div");
          image.className = "cart-tile";
          image.setAttribute("aria-hidden", "true");
          image.textContent = product.name;
        }
        const details = document.createElement("div");
        const h = document.createElement("h2");
        h.textContent = product.name;
        const p = document.createElement("p");
        p.textContent = product.description;
        const price = document.createElement("p");
        price.textContent = money(product.price);
        details.append(h, p, price);
        const controls = document.createElement("div");
        const label = document.createElement("label");
        label.textContent = "Quantity";
        const input = document.createElement("input");
        input.type = "number";
        input.min = "1";
        input.max = "10";
        input.step = "1";
        input.value = String(line.quantity);
        input.setAttribute(
          "aria-label",
          `${product.name} ${line.size} quantity`,
        );
        label.append(input);
        input.addEventListener("change", () => {
          try {
            const next = readCart();
            next[index].quantity = Number(input.value);
            writeCart(next);
            render();
          } catch (e) {
            error.textContent =
              e instanceof Error ? e.message : "Unable to save bag.";
            input.value = String(line.quantity);
          }
        });
        const remove = document.createElement("button");
        remove.className = "text-link";
        remove.textContent = "Remove";
        remove.setAttribute(
          "aria-label",
          `Remove ${product.name} ${line.size}`,
        );
        remove.addEventListener("click", () => {
          try {
            writeCart(readCart().filter((_, i) => i !== index));
            render();
          } catch {
            error.textContent = "Unable to update bag. Check browser storage.";
          }
        });
        controls.append(label, remove);
        article.append(image, details, controls);
        host.append(article);
      });
      const total = totals(lines);
      document.querySelector("#cart-total")!.textContent = total.unknown
        ? `${money(total.subtotal)} + price on request`
        : money(total.subtotal);
      document.querySelector("#cart-unknown")!.textContent = total.unknown
        ? `Priced items subtotal: ${money(total.subtotal)}. Other items: price on request.`
        : "";
    } catch (e) {
      host.replaceChildren();
      document.querySelector<HTMLElement>("#cart-summary")!.hidden = true;
      error.textContent =
        e instanceof Error ? e.message : "Unable to read bag.";
      reset.hidden = false;
    }
  }
  reset.addEventListener("click", () => {
    try {
      writeCart([]);
      render();
    } catch {
      error.textContent = "Browser storage is unavailable.";
    }
  });
  render();
  window.addEventListener("storage", render);
</script>
<style is:global>
  .cart-line {
    display: grid;
    grid-template-columns: 200px 1fr 100px;
    gap: 32px;
    padding: 30px 0;
    border-bottom: 1px solid #ddd;
  }
  .cart-line img {
    width: 200px;
    height: 150px;
    object-fit: cover;
  }
  .cart-tile {
    width: 200px;
    height: 150px;
    background: #f7f7f7;
    display: flex;
    align-items: flex-end;
    padding: 14px;
    font-size: 12px;
    color: #666;
  }
  .cart-line h2 {
    font-size: 28px;
    letter-spacing: -0.03em;
  }
  .cart-line p {
    font-size: 13px;
    max-width: 650px;
  }
  .cart-line button {
    border: 0;
    background: none;
    font-size: 12px;
    min-height: 44px;
  }
  .cart-line input {
    width: 80px;
  }
  @media (max-width: 767px) {
    .cart-line {
      grid-template-columns: 100px 1fr;
      gap: 18px;
    }
    .cart-line img,
    .cart-tile {
      width: 100px;
      height: 85px;
    }
    .cart-line > div:last-child {
      grid-column: 2;
    }
    .cart-line h2 {
      font-size: 24px;
    }
    #cart-summary .bar {
      flex-direction: column;
    }
  }
</style>
