---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/urls";
const pages = {
  about: {
    title: "Czech roots. Northern horizons.",
    eyebrow: "About Equator",
    paragraphs: [
      "Equator is a Czech cycling brand focused on titanium bicycles and carbon wheels. The company describes its bicycles as designed, tested and assembled in Czechia, using globally sourced parts.",
      "The three bicycle families explore different ways to ride: Sensei for road and gravel, Raiden for the road, and Yasei for longer adventures. Factory builds offer a starting point for a personal conversation.",
      "Equator Scandinavia is an exploratory regional representation project, starting in Copenhagen. The intended role is to help riders and potential partners connect with Equator. This website is a prototype, and commercial arrangements are not presented as finalized.",
    ],
    source: "https://www.equator-cycling.com/o-nas/",
  },
  privacy: {
    title: "Privacy, clearly.",
    eyebrow: "Prototype notice / Final policy pending",
    paragraphs: [
      "This prototype does not send inquiry forms to Equator or an email service. Please use fictional details. Form contact fields are not saved by the application.",
      "Your browser stores product configurations and your bag in localStorage. A demo reference, timestamp and product summary are stored in sessionStorage. You can remove this information using your browser’s site-data controls.",
      "Before real inquiries are enabled, the legal operator, controller responsibilities, processing services, retention period, contact information and privacy rights process must be approved and documented. This notice is not the final production privacy policy.",
    ],
  },
  terms: {
    title: "A conversation comes first.",
    eyebrow: "Terms / Approval pending",
    paragraphs: [
      "This is a prototype. Adding an item to the bag or previewing an inquiry does not place an order or create a confirmed purchase. No payments are collected.",
      "Displayed EUR prices are dated manufacturer references. They are not approved Scandinavian offers. Final pricing, specifications, availability, delivery and applicable terms require confirmation before a purchase.",
      "The seller’s identity, regional representation arrangements and production terms have not been finalized for this website. No commercial terms should be inferred from this prototype.",
    ],
  },
  warranty: {
    title: "Support for the road ahead.",
    eyebrow: "Warranty / Confirmation required",
    paragraphs: [
      "Warranty coverage, eligibility and the claims process for Scandinavian customers need confirmation with Equator before launch.",
      "We do not offer a new warranty or lifetime guarantee through this prototype. Manufacturer statements about long-term ownership are not a substitute for approved warranty terms.",
      "The manufacturer’s terms refer to separate warranty conditions. Confirm the policy applicable to the specific product and purchase.",
    ],
    source: "https://www.equator-cycling.com/obchodni-podminky/",
  },
  "crash-replacement": {
    title: "When the unexpected happens.",
    eyebrow: "Crash replacement / Confirmation required",
    paragraphs: [
      "Equator publishes a crash replacement program for its wheels. The terms and applicability to a particular product must be checked directly with the manufacturer.",
      "Regional eligibility, costs and arrangements have not been confirmed for this website. No free replacement, discount or repair timeframe is promised here.",
    ],
    source: "https://www.equator-cycling.com/crash-replacement-program/",
  },
  shipping: {
    title: "From the workshop to your ride.",
    eyebrow: "Delivery / Confirmation required",
    paragraphs: [
      "Delivery availability, destination, cost and estimated timing will be confirmed personally before any purchase.",
      "A dated stock statement on the manufacturer’s website is not a delivery promise. Scandinavian pricing, taxes, import handling and delivery arrangements require confirmation, especially across different countries.",
      "No delivery terms have been approved for this prototype.",
    ],
  },
  cookies: {
    title: "Only what this demo needs.",
    eyebrow: "Browser storage",
    paragraphs: [
      "This prototype does not include analytics or advertising scripts. It uses browser storage for your bag, selected bicycle configuration and product-only demo receipt.",
      "The application does not set tracking cookies. Hosting providers may have their own technical processing; that must be reviewed when a production host is activated.",
      "Clear site data in your browser to remove saved configurations and cart contents. A future production storage notice must reflect the services actually enabled.",
    ],
  },
  faq: {
    title: "A few useful answers.",
    eyebrow: "Questions, answered",
    paragraphs: [
      "Can I buy here? This is a prototype. You can explore configurations and preview an inquiry, but no order, email or payment is processed.",
      "Can I choose other components? The configurator offers listed factory builds only. Other changes require a conversation and compatibility confirmation.",
      "Are the prices final? No. They are manufacturer reference prices in EUR, checked on the date shown. Final regional pricing and delivery require confirmation.",
      "Why are there few wheels and accessories? The collection is deliberately small. Products with unresolved availability or specifications are held for review.",
      "Are the photographs final? No. These are genuine Equator photographs used with permission. Future studio photography can replace them without changing the product pages.",
    ],
  },
};
export function getStaticPaths() {
  return [
    "about",
    "privacy",
    "terms",
    "warranty",
    "crash-replacement",
    "shipping",
    "cookies",
    "faq",
  ].map((page) => ({ params: { page } }));
}
const page = pages[Astro.params.page as keyof typeof pages];
---

<Layout title={page.title}>
  <section class="wrap">
    <div class="page-heading">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
    </div>
    <div class="prose">
      {page.paragraphs.map((text) => (
        <p>{text}</p>
      ))}
      {"source" in page && (
        <p>
          <a href={page.source}>Read the manufacturer’s source ↗</a>
          <br />
          <small>Reviewed 16 October 2026.</small>
        </p>
      )}
      <a class="button" href={url("bikes/")}>
        Explore the bicycles ↗
      </a>
    </div>
  </section>
</Layout>
