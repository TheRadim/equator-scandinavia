---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/urls";
import { representativeEmail, umamiWebsiteId } from "../lib/config";
import { site } from "../data/site";
// Where people are told to write: the address if shown, otherwise the contact form.
const writeTo = site.showEmail ? representativeEmail : "us through the contact page";
const pages = {
  privacy: {
    title: "Privacy policy",
    description: "How Equator Scandinavia uses the details you send with a message or order inquiry, and how to see, correct or delete them.",
    eyebrow: "Privacy",
    paragraphs: [
      `This website is run by Equator Scandinavia, the Scandinavian representative of Equator Cycling. Contact: ${site.showEmail ? representativeEmail : "use the form on our contact page"}.`,
      "When you send a message or an order inquiry we receive your name, email address, phone number (if given), your message and the products in your bag. We use this only to answer you and to arrange your order with Equator Cycling, who manufacture the products.",
      "Messages are delivered to us by a form-handling service acting on our behalf. We don't sell your details or use them for marketing without asking you first.",
      ...(umamiWebsiteId
        ? ["Visits are counted anonymously with Umami (no cookies, no personal data): pages viewed, country, referring website, device type and visit length."]
        : []),
      "Your bag and saved bike configurations are stored in your own browser (local storage) and never sent to us until you submit an inquiry. You can clear them at any time in your browser settings.",
      `You can ask to see, correct or delete the information we hold about you by writing to ${writeTo}.`,
    ],
  },
  terms: {
    title: "How ordering works",
    description: "How ordering an Equator bike, wheelset or part works: send an inquiry, get a written confirmation of price and delivery, then decide.",
    eyebrow: "Terms",
    paragraphs: [
      "Equator bikes, wheels and components come from Equator Cycling, Czech Republic, and are sold in Denmark, Sweden and Norway through Equator Scandinavia.",
      "Adding products to your bag and sending an inquiry does not create a purchase or any obligation. We reply with a written confirmation of price, availability, delivery and payment. Your order is placed only when you accept that confirmation.",
      "Prices on this website are shown in EUR as a guide. The confirmed price, including delivery to your country, is stated in your order confirmation.",
      "Product specifications come from Equator Cycling and may change. We confirm the exact specification of your build before you order.",
    ],
  },
  warranty: {
    title: "Warranty",
    description: "Warranty on Equator titanium frames, carbon wheels and components bought through Equator Scandinavia, and how a claim is handled.",
    eyebrow: "Support",
    paragraphs: [
      "Equator products are covered by Equator Cycling's warranty conditions. The terms that apply to your product are confirmed in writing with your order.",
      `If something isn't right with your Equator, write to ${writeTo} with your order reference and a few photos. We'll handle the contact with Equator for you.`,
    ],
    source: "https://www.equator-cycling.com/obchodni-podminky/",
  },
  "crash-replacement": {
    title: "Crash replacement",
    description: "Crash replacement for Equator carbon wheels: what to do after a crash and how we check the programme with Equator for you.",
    eyebrow: "Support",
    paragraphs: [
      "Equator runs a crash replacement programme for its carbon wheels. If your wheel is damaged in a crash, contact us with your order reference and photos, and we'll check with Equator what the programme offers for your wheel.",
    ],
    source: "https://www.equator-cycling.com/crash-replacement-program/",
  },
  shipping: {
    title: "Shipping & delivery",
    description: "Delivery of Equator bikes, wheels and parts to Denmark, Sweden and Norway, shipped from Equator in the Czech Republic.",
    eyebrow: "Delivery",
    paragraphs: [
      "We deliver to Denmark, Sweden and Norway. Bikes and framesets ship from Equator in the Czech Republic.",
      "Delivery cost and the expected delivery date depend on the product and your location. Both are stated in your order confirmation before you pay.",
      "Products marked In stock are available at Equator; products marked Restocking or Made to order have a longer lead time, which we confirm with you.",
    ],
  },
  cookies: {
    title: "Cookies",
    description: "Equator Scandinavia uses no tracking or advertising cookies. Your bag and currency choice are kept in your own browser.",
    eyebrow: "Privacy",
    paragraphs: [
      umamiWebsiteId
        ? "This website uses no cookies for advertising or analytics. We count visits with Umami, a privacy-friendly statistics service that sets no cookies and stores no personal data: we see which pages are read, roughly from which country, from which website people arrive and how long a visit lasts, never who you are."
        : "This website doesn't use advertising or analytics cookies, and doesn't track you.",
      "It stores your bag, your bike configuration and your chosen currency in your browser's local storage so they are still there when you come back. Clear your browser's site data to remove them.",
    ],
  },
  faq: {
    title: "Questions & answers",
    description: "How ordering Equator bikes and wheels works: inquiries, payment, changing components, choosing a size, and selling Equator in your shop.",
    eyebrow: "FAQ",
    paragraphs: [
      "How do I order? Configure your bike or choose your parts, add them to your bag and send an inquiry. We confirm price, availability and delivery in writing, and you order once you're happy.",
      "Do I pay online? No. Payment is arranged after you have accepted your order confirmation.",
      "Can I change components? The configurator shows Equator's factory builds. Mention any changes in your message and we'll check compatibility and price with Equator.",
      "Which size do I need? Tell us your height and inseam in your message and we'll help you choose.",
      "Are you a shop? We are the Scandinavian representative of Equator Cycling. Interested in selling Equator in your shop? Get in touch through the contact page.",
    ],
  },
};
export function getStaticPaths() {
  return [
    "privacy",
    "terms",
    "warranty",
    "crash-replacement",
    "shipping",
    "cookies",
    "faq",
  ].map((page) => ({ params: { page } }));
}
const page = pages[Astro.params.page as keyof typeof pages];
---

<Layout title={page.title} description={page.description}>
  <style>
    .faq-q { color: #171717; font-weight: 600; }
  </style>
  <section class="wrap">
    <div class="page-heading">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
    </div>
    <div class="prose">
      {page.paragraphs.map((text) => {
        const q = Astro.params.page === "faq" ? text.indexOf("? ") : -1;
        return q > 0 ? (
          <p>
            <strong class="faq-q">{text.slice(0, q + 1)}</strong>
            <br />
            {text.slice(q + 2)}
          </p>
        ) : (
          <p>{text}</p>
        );
      })}
      {"source" in page && (
        <p>
          <a href={page.source} rel="noopener">Equator Cycling's conditions (equator-cycling.com)</a>
        </p>
      )}
      <a class="button" href={url("bikes/")}>
        Explore the bicycles
      </a>
    </div>
  </section>
</Layout>
