---
import Layout from "../../layouts/Layout.astro";
import { wheels } from "../../data/wheels/catalog";
import { url } from "../../lib/urls";
export function getStaticPaths() {
  return wheels.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
const { product } = Astro.props;
---

<Layout title={product.name}>
  <div class="wrap section">
    <a class="text-link" href={url("wheels/")}>
      ← Wheels
    </a>
    <div class="wheel">
      <img
        src={url(product.image)}
        width="1024"
        height="768"
        alt={product.name}
      />
      <div>
        <p class="eyebrow">{product.category} / Carbon wheelset</p>
        <h1>{product.name}</h1>
        <p>{product.description}</p>
        <p class="price">Price on request</p>
        <p>
          Manufacturer reference from €1,411, checked 16 October 2026. Exact
          freehub specification and current pricing require confirmation.
        </p>
        <button class="button" data-add-wheel={product.id}>
          Add inquiry item ↗
        </button>
        <p class="status" role="status" id="wheel-status"></p>
        <hr />
        {Object.entries(product.specs).map(([key, value]) => (
          <p>
            <strong>{key}:</strong> {value}
          </p>
        ))}
        <p style="font-size:12px">{product.availability}</p>
        <a class="text-link" href={product.source}>
          Manufacturer specification ↗
        </a>
      </div>
    </div>
  </div>
</Layout>
<style>
  .wheel {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 70px;
    padding-top: 40px;
  }
  .wheel img {
    width: 100%;
    height: auto;
  }
  @media (max-width: 767px) {
    .wheel {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>

<script>
  import { addToCart } from "../../lib/storage";
  document
    .querySelector<HTMLButtonElement>("[data-add-wheel]")
    ?.addEventListener("click", (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const status = document.querySelector("#wheel-status")!;
      try {
        addToCart({
          productId: button.dataset.addWheel!,
          buildId: "inquiry",
          size: "",
        });
        status.textContent =
          "Added to your bag. Specification and price require confirmation.";
      } catch (e) {
        status.textContent =
          e instanceof Error ? e.message : "Unable to save bag.";
      }
    });
</script>
