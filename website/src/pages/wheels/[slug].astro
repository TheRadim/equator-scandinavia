---
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/Gallery.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { wheels, wheelCategories, type Wheel } from "../../data/wheels/catalog";
import { money } from "../../lib/catalog";
import { productJsonLd } from "../../lib/seo";
import { url } from "../../lib/urls";
export function getStaticPaths() {
  return wheels.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
const { product } = Astro.props as { product: Wheel };
const categoryLabel =
  wheelCategories.find((c) => c.id === product.category)?.label ??
  product.category;
const verified = new Date(product.verified).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout
  title={`${product.name} carbon wheelset`}
  description={`${product.name}: ${product.description}`}
  image={product.images[0]}
  jsonLd={productJsonLd({
    name: `Equator ${product.name}`,
    description: product.description,
    image: product.images[0],
    path: `wheels/${product.slug}/`,
    status: product.inventoryStatus,
  })}
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={url("wheels/")}>Wheels</a> /
      <a href={url(`wheels/?category=${product.category.toLowerCase()}`)}
        >{categoryLabel}</a
      > / {product.name}
    </nav>
    <div class="product-layout">
      <div class="product-media">
        <Gallery
          images={product.images}
          alt={`Equator ${product.name} carbon wheelset`}
          label={product.depthLabel}
          sublabel="mm rim depth"
        />
      </div>
      <div class="product-info">
        <p class="eyebrow">{categoryLabel} / Carbon wheelset</p>
        <h1>{product.name}</h1>
        <p class="lead">{product.description}</p>
        <p class="price">
          {product.price !== null
            ? money(product.price)
            : product.referenceFrom !== null
              ? `From ${money(product.referenceFrom)}`
              : "Price on request"}
        </p>
        <p class="caption">
          Manufacturer reference price, checked {verified}. Your price is
          confirmed personally before any payment.
        </p>
        <hr />
        <form class="wheel-form" data-wheel-form={product.id}>
          <fieldset>
            <legend>Freehub body</legend>
            <div class="option-grid">
              {product.freehubs.map((f, i) => (
                <label class="option">
                  <input
                    type="radio"
                    name="freehub"
                    value={f.id}
                    checked={i === 0}
                  />
                  <span class="option-title">{f.label}</span>
                </label>
              ))}
            </div>
            <p class="caption">
              Variant price differences and stock are confirmed with your
              inquiry.
            </p>
          </fieldset>
          <div class="availability">
            <StatusBadge status={product.inventoryStatus} />
            <p class="caption">{product.availability}</p>
          </div>
          <button class="button full" type="submit">
            Add to bag <span aria-hidden="true">↗</span>
          </button>
          <p class="status" role="status" data-status></p>
          <a class="text-link view-bag" href={url("cart/")} hidden data-view-bag
            >Review your bag</a
          >
        </form>
        <hr />
        <h2 class="spec-title">Specifications</h2>
        <dl class="specs">
          <div><dt>Intended use</dt><dd>{product.intendedUse}</dd></div>
          {Object.entries(product.specs).map(([key, value]) => (
            <div>
              <dt>{key}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        <a class="text-link" href={product.source} rel="noopener">
          Manufacturer specification ↗
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { addToCart } from "../../lib/storage";
  const form = document.querySelector<HTMLFormElement>("[data-wheel-form]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const freehub = new FormData(form).get("freehub");
    try {
      addToCart({
        productId: form.dataset.wheelForm!,
        buildId: String(freehub),
        size: "",
      });
      status.textContent =
        "Added to your bag. Price and availability are confirmed with your inquiry.";
      status.classList.remove("error");
      form.querySelector<HTMLElement>("[data-view-bag]")!.hidden = false;
    } catch (e) {
      status.textContent =
        e instanceof Error ? e.message : "Unable to save your bag.";
      status.classList.add("error");
    }
  });
</script>
