---
import PriceNote from "../../components/PriceNote.astro";
import Price from "../../components/Price.astro";
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/Gallery.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { wheels, wheelCategories, wheelFromPrice, type Wheel } from "../../data/wheels/catalog";
import { money, fromPrice } from "../../lib/catalog";
import { productJsonLd } from "../../lib/seo";
import { url } from "../../lib/urls";
export function getStaticPaths() {
  return wheels.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
const { product } = Astro.props as { product: Wheel };
const categoryLabel =
  wheelCategories.find((c) => c.id === product.category)?.label ??
  product.category;
---

<Layout
  title={`${product.name} carbon wheelset`}
  description={`${product.name}: ${product.description}`}
  image={product.images[0]}
  jsonLd={productJsonLd({
    name: `Equator ${product.name}`,
    description: product.description,
    image: product.images[0],
    path: `wheels/${product.slug}/`,
    status: product.inventoryStatus,
  })}
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={url("wheels/")}>Wheels</a>
      <span aria-hidden="true">/</span>
      <a href={url(`wheels/?category=${product.category.toLowerCase()}`)}>{categoryLabel}</a>
      <span aria-hidden="true">/</span>
      {product.name}
    </nav>
    <div class="product-layout">
      <div class="product-media">
        <Gallery
          images={product.images}
          alt={`Equator ${product.name} carbon wheelset`}
          label={product.depthLabel}
          sublabel="mm rim depth"
        />
      </div>
      <div class="product-info">
        <p class="eyebrow">{categoryLabel} / Carbon wheelset</p>
        <h1>{product.name}</h1>
        <p class="lead">{product.description}</p>
        <p class="made-note">Hand-built in Zlín, Czech Republic</p>
        <p class="price" data-wheel-price>{fromPrice(wheelFromPrice(product))}</p>
        <PriceNote />
        <hr />
        <form class="wheel-form" data-wheel-form={product.id} data-wheel={JSON.stringify({ brakes: product.brakes.map((b) => ({ id: b.id, price: b.price })), tubelessPrice: product.tubelessPrice })}>
          {
            product.brakes.length > 1 && (
              <fieldset>
                <legend>Brake type</legend>
                <div class="option-grid">
                  {product.brakes.map((b, i) => (
                    <label class="option">
                      <input type="radio" name="brake" value={b.id} checked={i === 0} />
                      <span class="option-title">{b.label}</span>
                      <span class="option-meta"><Price amount={b.price} /></span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }
          {product.brakes.length === 1 && <input type="hidden" name="brake" value={product.brakes[0].id} />}
          <fieldset>
            <legend>Freehub body</legend>
            <div class="option-grid two">
              {product.freehubs.map((f, i) => (
                <label class="option">
                  <input type="radio" name="freehub" value={f.id} checked={i === 0} />
                  <span class="option-title">{f.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          {
            product.tubelessPrice !== null && (
              <fieldset>
                <legend>Tyre setup</legend>
                <div class="option-grid">
                  <label class="option">
                    <input type="radio" name="tubeless" value="std" checked />
                    <span class="option-title">Standard</span>
                    <span class="option-meta">For tubes</span>
                  </label>
                  <label class="option">
                    <input type="radio" name="tubeless" value="tl" />
                    <span class="option-title">Tubeless setup</span>
                    <span class="option-meta">Tape and valves fitted · +<Price amount={product.tubelessPrice} /></span>
                  </label>
                </div>
              </fieldset>
            )
          }
          {product.brakes.map((b, i) => (
            <div class="availability" data-brake-panel={b.id} hidden={i > 0}>
              <StatusBadge status={b.inventoryStatus} />
              <p class="caption">{b.availability}</p>
            </div>
          ))}
          <button class="button full" type="submit">Add to bag</button>
          <p class="status" role="status" data-status></p>
          <a class="text-link view-bag" href={url("cart/")} hidden data-view-bag>Review your bag</a>
        </form>
        <hr />
        <h2 class="spec-title">Specifications</h2>
        {product.brakes.map((b, i) => (
          <dl class="specs" data-brake-panel={b.id} hidden={i > 0}>
            <div><dt>Intended use</dt><dd>{product.intendedUse}</dd></div>
            {Object.entries({ ...product.specs, ...b.specs }).map(([key, value]) => (
              <div>
                <dt>{key}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  import { addToCart } from "../../lib/storage";
  import { money } from "../../lib/catalog";
  import { encodeWheelBuild } from "../../data/wheels/catalog";
  const form = document.querySelector<HTMLFormElement>("[data-wheel-form]");
  if (form) {
    const cfg = JSON.parse(form.dataset.wheel!) as {
      brakes: { id: string; price: number | null }[];
      tubelessPrice: number | null;
    };
    const priceEl = document.querySelector<HTMLElement>("[data-wheel-price]")!;
    const value = (n: string) => String(new FormData(form).get(n) ?? "");
    const render = () => {
      const brake = cfg.brakes.find((b) => b.id === value("brake")) ?? cfg.brakes[0];
      const tl = value("tubeless") === "tl";
      priceEl.textContent = money(
        brake.price === null ? null : brake.price + (tl ? (cfg.tubelessPrice ?? 0) : 0),
      );
      document
        .querySelectorAll<HTMLElement>("[data-brake-panel]")
        .forEach((el) => (el.hidden = el.dataset.brakePanel !== brake.id));
    };
    render();
    form.addEventListener("change", render);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>("[data-status]")!;
      try {
        addToCart({
          productId: form.dataset.wheelForm!,
          buildId: encodeWheelBuild(value("brake"), value("freehub"), value("tubeless") === "tl"),
          size: "",
        });
        status.textContent = "Added to your bag.";
        status.classList.remove("error");
        form.querySelector<HTMLElement>("[data-view-bag]")!.hidden = false;
      } catch (e) {
        status.textContent = e instanceof Error ? e.message : "Unable to save your bag.";
        status.classList.add("error");
      }
    });
  }
</script>

<style>
  .made-note {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #444;
    border: 1px solid #ddd;
    padding: 4px 8px;
    margin: 14px 0 20px;
    line-height: 1.4;
  }
</style>
