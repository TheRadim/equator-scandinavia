---
import Layout from "../../layouts/Layout.astro";
import { wheels, wheelCategories } from "../../data/wheels/catalog";
import WheelCard from "../../components/WheelCard.astro";
import { url } from "../../lib/urls";
---

<Layout
  title="Carbon wheels"
  description="Equator carbon wheelsets for road, gravel and time trial, hand-built and tested in Zlín, Czech Republic. Disc or rim brake, any freehub, tubeless ready."
  image="images/wavy-50-1.png"
>
  <div class="wrap section">
    <p class="eyebrow">Carbon collection</p>
    <h1>Keep moving.</h1>
    <p class="intro">
      Carbon wheels for road, gravel and the race against the clock, built by
      hand in Zlín, Czech Republic.
    </p>
    <div class="filters" role="group" aria-label="Wheel category">
      {[{ id: "All", label: "All" }, ...wheelCategories].map((c, i) => (
        <button
          type="button"
          class="filter"
          data-filter={c.id}
          aria-pressed={i === 0}
        >
          {c.label}
        </button>
      ))}
    </div>
    <h2 class="visually-hidden">Wheelsets</h2>
    <div class="grid3" data-reveal-group>
      {wheels.map((w) => <WheelCard wheel={w} />)}
    </div>
    <section class="made-in" aria-labelledby="made-in-title">
      <div>
        <p class="eyebrow">Built in the EU</p>
        <h2 id="made-in-title">Hand-built in Zlín.</h2>
      </div>
      <div>
        <p>
          Equator sources rims, hubs and spokes from specialist suppliers
          worldwide. Every wheel is then assembled, tested and finished by hand
          in Equator's workshop in Zlín, Czech Republic.
        </p>
        <p>
          The details are chosen to last: Sapim CX-Ray spokes, brass nipples,
          Enduro sealed bearings and Toray T700/T800 carbon rims.
        </p>
      </div>
    </section>
    <div class="empty" id="no-wheels" hidden>
      <h2 class="h3">Let’s find the right wheelset.</h2>
      <p>
        We’re confirming the current range for this category. No availability is
        assumed.
      </p>
      <a class="text-link" href={url("contact/")}>
        Discuss your riding
      </a>
    </div>
  </div>
</Layout>
<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-filter]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        let count = 0;
        document
          .querySelectorAll<HTMLElement>("[data-category]")
          .forEach((card) => {
            card.hidden =
              button.dataset.filter !== "All" &&
              card.dataset.category !== button.dataset.filter;
            if (!card.hidden) count++;
          });
        document
          .querySelectorAll("[data-filter]")
          .forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        document.querySelector<HTMLElement>("#no-wheels")!.hidden = count > 0;
        const next = new URL(location.href);
        if (button.dataset.filter === "All") next.searchParams.delete("category");
        else next.searchParams.set("category", button.dataset.filter!.toLowerCase());
        history.replaceState(null, "", next);
      }),
    );
  const initial = new URLSearchParams(location.search).get("category");
  if (initial)
    [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")]
      .find((b) => b.dataset.filter!.toLowerCase() === initial.toLowerCase())
      ?.click();
</script>
<style>
  .intro {
    max-width: 560px;
  }
  .made-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 64px;
    margin-top: 88px;
    padding: 56px;
    background: #f7f7f7;
  }
  .made-in h2 {
    font-size: clamp(1.9rem, 3.4vw, 3rem);
  }
  .made-in p {
    max-width: 560px;
  }
  @media (max-width: 767px) {
    .made-in {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 28px 22px;
      margin-top: 56px;
    }
  }
  .filters {
    display: flex;
    gap: 0;
    flex-wrap: wrap;
    margin: 35px 0;
  }
  .filter {
    min-height: 44px;
    padding: 10px 2px;
    margin-right: 22px;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    font-size: 14px;
    color: #666;
  }
  .filter[aria-pressed="true"] {
    color: #171717;
    border-bottom-color: #171717;
  }
</style>
