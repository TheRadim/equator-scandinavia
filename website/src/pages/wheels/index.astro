---
import Layout from "../../layouts/Layout.astro";
import { wheels, wheelCategories } from "../../data/wheels/catalog";
import WheelCard from "../../components/WheelCard.astro";
import { url } from "../../lib/urls";
---

<Layout title="Carbon wheels">
  <div class="wrap section">
    <p class="eyebrow">Carbon collection</p>
    <h1>Keep moving.</h1>
    <p>
      A considered selection for road, gravel and the race against the clock.
    </p>
    <div class="filters" role="group" aria-label="Wheel category">
      {[{ id: "All", label: "All" }, ...wheelCategories].map((c, i) => (
        <button
          type="button"
          class="filter"
          data-filter={c.id}
          aria-pressed={i === 0}
        >
          {c.label}
        </button>
      ))}
    </div>
    <h2 class="visually-hidden">Wheelsets</h2>
    <div class="grid3">
      {wheels.map((w) => <WheelCard wheel={w} />)}
    </div>
    <div class="empty" id="no-wheels" hidden>
      <h2 class="h3">Let’s find the right wheelset.</h2>
      <p>
        We’re confirming the current range for this category. No availability is
        assumed.
      </p>
      <a class="text-link" href={url("contact/")}>
        Discuss your riding ↗
      </a>
    </div>
  </div>
</Layout>
<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-filter]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        let count = 0;
        document
          .querySelectorAll<HTMLElement>("[data-category]")
          .forEach((card) => {
            card.hidden =
              button.dataset.filter !== "All" &&
              card.dataset.category !== button.dataset.filter;
            if (!card.hidden) count++;
          });
        document
          .querySelectorAll("[data-filter]")
          .forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        document.querySelector<HTMLElement>("#no-wheels")!.hidden = count > 0;
        const next = new URL(location.href);
        if (button.dataset.filter === "All") next.searchParams.delete("category");
        else next.searchParams.set("category", button.dataset.filter!.toLowerCase());
        history.replaceState(null, "", next);
      }),
    );
  const initial = new URLSearchParams(location.search).get("category");
  if (initial)
    [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")]
      .find((b) => b.dataset.filter!.toLowerCase() === initial.toLowerCase())
      ?.click();
</script>
<style>
  .filters {
    display: flex;
    gap: 0;
    flex-wrap: wrap;
    margin: 35px 0;
  }
  .filter {
    min-height: 44px;
    padding: 10px 2px;
    margin-right: 22px;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    font-size: 14px;
    color: #666;
  }
  .filter[aria-pressed="true"] {
    color: #171717;
    border-bottom-color: #171717;
  }
</style>
