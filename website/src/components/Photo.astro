---
/**
 * Responsive photograph: WebP 640/1024 variants (from `npm run images`) with
 * the original JPG/PNG as fallback.
 */
import sharp from "sharp";
import { url } from "../lib/urls";
interface Props {
  src: string;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  width?: number;
  height?: number;
}
const {
  src,
  alt,
  sizes = "(max-width: 900px) 100vw, 50vw",
  eager = false,
  class: cls,
} = Astro.props;
// Real dimensions at build time: correct width/height (no layout shift) and a
// "portrait" class so tall photos are shown whole instead of cropped.
const meta = await sharp(`public/${src}`).metadata();
const width = meta.width ?? 1024;
const height = meta.height ?? 768;
const portrait = height > width * 0.9;
const base = src.replace(/\.(jpe?g|png)$/i, "");
---

<picture>
  <source
    type="image/webp"
    srcset={`${url(base + "-640.webp")} 640w, ${url(base + "-1024.webp")} 1024w`}
    sizes={sizes}
  />
  <img
    class:list={[cls, portrait && "portrait"]}
    src={url(src)}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
</picture>
