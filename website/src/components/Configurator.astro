---
const {product}=Astro.props;
---
<form data-configurator={product.id}>
<fieldset><legend>01 / Choose your build</legend><label>Build type<select name="type"><option value="complete">Complete bicycle</option><option value="frameset">Frameset only</option></select></label></fieldset>
<fieldset><legend>02 / Find your fit</legend><label>Frame size<select name="size" required><option value="">Select your size</option>{product.sizes.map((s:string)=><option value={s}>{s}</option>)}</select></label><a class="text-link" href="#size-guide">View size guidance ↑</a></fieldset>
<fieldset data-complete><legend>03 / Factory build</legend><label>Groupset & matched wheels<select name="build"></select></label><p class="config-detail" data-wheels></p><p class="config-detail" data-components></p><p class="config-detail">Wheels and components follow the selected factory build. Bespoke changes can be discussed separately.</p></fieldset>
<div class="config-review" aria-live="polite"><span class="eyebrow">Your build / Reference estimate</span><p class="price" data-price></p><p data-summary class="config-detail"></p><p class="config-detail">No payment. Pricing and availability require personal confirmation.</p></div><button class="button" type="submit" style="width:100%">Add to bag <span>↗</span></button><p class="status" data-status role="status"></p><noscript><p>Enable JavaScript to configure a bicycle. Product details and manufacturer links remain available.</p></noscript>
</form>
<script>
import {bikes} from '../data/bikes/catalog';import {money} from '../lib/catalog';import {addToCart} from '../lib/storage';
const form=document.querySelector<HTMLFormElement>('[data-configurator]');
if(form){
 const product=bikes.find(b=>b.id===form.dataset.configurator)!;
 const type=form.elements.namedItem('type') as HTMLSelectElement,size=form.elements.namedItem('size') as HTMLSelectElement,build=form.elements.namedItem('build') as HTMLSelectElement;
 const status=form.querySelector<HTMLElement>('[data-status]')!;const key=`equator-config-${product.id}`;
 const renderOptions=()=>{const previous=build.value;build.replaceChildren(...product.builds.filter(b=>b.type===type.value).map(b=>{const o=new Option(`${b.label} — ${money(b.price)}`,b.id);return o;}));if([...build.options].some(o=>o.value===previous))build.value=previous;};
 const render=()=>{const selected=product.builds.find(b=>b.id===build.value)!;form.querySelector<HTMLElement>('[data-complete]')!.hidden=type.value==='frameset';build.disabled=type.value==='frameset';form.querySelector('[data-price]')!.textContent=money(selected.price);form.querySelector('[data-wheels]')!.textContent=selected.wheels?`Wheels: ${selected.wheels}`:'';form.querySelector('[data-components]')!.textContent=selected.components||'';form.querySelector('[data-summary]')!.textContent=`${product.name} · ${selected.label} · ${size.value||'Choose a size'}`;try{localStorage.setItem(key,JSON.stringify({type:type.value,size:size.value,build:build.value}));}catch{status.textContent='Browser storage is unavailable. Your selection cannot be saved.';}};
 try{const saved=JSON.parse(localStorage.getItem(key)||'null');if(saved){type.value=['frameset','complete'].includes(saved.type)?saved.type:'complete';size.value=product.sizes.includes(saved.size)?saved.size:'';renderOptions();if(product.builds.some(b=>b.id===saved.build&&b.type===type.value))build.value=saved.build;}else renderOptions();}catch{renderOptions();}
 render();type.addEventListener('change',()=>{renderOptions();render();});size.addEventListener('change',render);build.addEventListener('change',render);
 form.addEventListener('submit',event=>{event.preventDefault();try{addToCart({productId:product.id,buildId:build.value,size:size.value});status.textContent='Added to your bag. Continue exploring or open your bag to review.';status.classList.remove('error');}catch(error){status.textContent=error instanceof Error?error.message:'Unable to save. Please check browser storage.';status.classList.add('error');}});
 form.querySelector('a[href="#size-guide"]')?.addEventListener('click',()=>{document.querySelector<HTMLDetailsElement>('#size-guide')!.open=true;});
}
</script>
<style>.config-detail{font-size:12px;line-height:1.7}.config-review{padding:24px;background:#f7f7f7;margin-bottom:20px}.config-review .eyebrow{font-size:9px}.config-review .price{margin:14px 0}.config-review p:last-child{margin-bottom:0}</style>
