---
/**
 * Shared contact / order-inquiry form: name, email, phone, message.
 * Delivery (see lib/config.ts): Worker → Formspree → visitor's email app.
 * The bag is cleared only after a server accepted the inquiry. Customer
 * details are never written to browser storage.
 */
import { url } from "../lib/urls";
import {
  deliveryMode,
  formspreeId,
  inquiryEndpoint,
  representativeEmail,
  turnstileSiteKey,
} from "../lib/config";
const { kind = "order" } = Astro.props as { kind?: "order" | "contact" };
const submitLabel = kind === "order" ? "Send order inquiry" : "Send message";
const endpoint =
  deliveryMode === "worker"
    ? inquiryEndpoint
    : deliveryMode === "formspree"
      ? `https://formspree.io/f/${formspreeId}`
      : "";
---

<form
  data-inquiry={kind}
  data-mode={deliveryMode}
  data-endpoint={endpoint}
  data-email={representativeEmail}
  novalidate
>
  <div class="form-pair">
    <label>
      Name
      <input id={`${kind}-name`} name="name" required maxlength="100" autocomplete="name" />
    </label>
    <label>
      Email
      <input id={`${kind}-email`} name="email" type="email" required maxlength="200" autocomplete="email" />
    </label>
  </div>
  <label>
    Phone <span class="muted">(optional)</span>
    <input id={`${kind}-phone`} name="phone" type="tel" maxlength="40" autocomplete="tel" pattern="[+()0-9 .\-]{5,40}" />
  </label>
  <label>
    Message {kind === "order" && <span class="muted">(optional)</span>}
    <textarea
      id={`${kind}-message`}
      name="message"
      maxlength="2000"
      required={kind === "contact"}
      placeholder={kind === "order"
        ? "Your height and inseam, delivery country, questions about components…"
        : "Bikes, wheels, a custom build or a dealer partnership — how can we help?"}
    ></textarea>
  </label>
  <div class="hp" aria-hidden="true">
    <label>Leave empty <input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <label class="consent">
    <input id={`${kind}-consent`} name="consent" type="checkbox" required />
    <span>
      I agree that my details are used to answer this {kind === "order" ? "inquiry" : "message"}, as
      described in the <a href={url("privacy/")}>privacy policy</a>.
    </span>
  </label>
  {
    deliveryMode === "worker" && turnstileSiteKey && (
      <>
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" />
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
      </>
    )
  }
  <button class="button full" type="submit" disabled>
    <span data-label>{submitLabel}</span>
  </button>
  <p class="caption form-foot">
    {kind === "order"
      ? "No payment now. We confirm price, availability and delivery with you before you order."
      : `Or email us directly: ${representativeEmail}`}
  </p>
  <p class="status" role="status" aria-live="polite" data-status></p>
  <noscript>
    <p>Please email us at {representativeEmail}.</p>
  </noscript>
</form>

<script>
  import { readCart, writeCart } from "../lib/storage";
  import { activeCurrency, money, resolve, totalLabel, totals } from "../lib/catalog";
  import { url } from "../lib/urls";

  const form = document.querySelector<HTMLFormElement>("[data-inquiry]");
  if (form) {
    const kind = form.dataset.inquiry as "order" | "contact";
    const mode = form.dataset.mode as "worker" | "formspree" | "email";
    const endpoint = form.dataset.endpoint || "";
    const inbox = form.dataset.email || "";
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.querySelector<HTMLElement>("[data-label]")!;
    const idleLabel = label.textContent;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const startedAt = Date.now();
    // One key per form view: a retry after a network error never sends twice.
    let idempotencyKey = crypto.randomUUID();

    const fail = (message: string) => {
      status.textContent = message;
      status.classList.add("error");
      button.disabled = false;
      label.textContent = idleLabel;
    };
    const makeReference = () => {
      const d = new Date().toISOString().slice(0, 10).replace(/-/g, "");
      const alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
      const tail = [...crypto.getRandomValues(new Uint8Array(5))]
        .map((n) => alphabet[n % alphabet.length])
        .join("");
      return `EQ-${d}-${tail}`;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status.classList.remove("error");
      status.textContent = "";
      if (!form.checkValidity()) {
        const invalid = form.querySelector<HTMLElement>(":invalid");
        const messages: Record<string, string> = {
          name: "Please enter your name.",
          email: "Please enter a valid email address.",
          phone: "Please check your phone number.",
          message: "Please write a short message.",
          consent: "Please accept the privacy policy to continue.",
        };
        fail(messages[invalid?.getAttribute("name") || ""] || "Please check the highlighted field.");
        invalid?.focus();
        return;
      }
      let items: ReturnType<typeof readCart> = [];
      try {
        items = kind === "order" ? readCart() : [];
      } catch {
        return fail("Your saved bag could not be read. Open your bag to reset it.");
      }
      if (kind === "order" && !items.length)
        return fail("Your bag is empty. Add a product before sending an inquiry.");

      const data = new FormData(form);
      const field = (n: string) => String(data.get(n) || "").trim();
      const summary = items.map((line) => {
        const r = resolve(line);
        return { quantity: line.quantity, name: r.name, description: r.description, price: r.price, ids: line };
      });
      const total = totals(items);
      const orderText = summary.length
        ? [
            ...summary.map(
              (l) =>
                `${l.quantity} × ${l.name} — ${l.description} — ${money(l.price)} [${l.ids.productId}/${l.ids.buildId}${l.ids.size ? "/" + l.ids.size : ""}]`,
            ),
            `Estimated total: ${totalLabel(total)}`,
            ...(activeCurrency() !== "EUR"
              ? [`Shown to the customer in ${activeCurrency()}; EUR subtotal of priced items: ${money(total.subtotal, "EUR")}`]
              : []),
          ].join("\n")
        : "";
      const reference = makeReference();
      const saveReceipt = (ref: string, timestamp: string, sent: boolean) =>
        sessionStorage.setItem(
          "equator-inquiry-receipt",
          JSON.stringify({ sent, kind, reference: ref, timestamp, items: summary, totals: total }),
        );

      button.disabled = true;
      label.textContent = "Sending…";

      if (mode === "email") {
        const subject =
          kind === "order" ? `Order inquiry ${reference} — ${field("name")}` : `Message from ${field("name")}`;
        const body = [
          `Name: ${field("name")}`,
          `Email: ${field("email")}`,
          `Phone: ${field("phone") || "—"}`,
          "",
          field("message") || "—",
          ...(orderText ? ["", "Order:", orderText] : []),
        ].join("\n");
        window.location.href = `mailto:${inbox}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        status.textContent = `Your email app should open with the message ready to send. If it doesn't, write to ${inbox}.`;
        button.disabled = false;
        label.textContent = idleLabel;
        return;
      }

      try {
        let res: Response;
        if (mode === "formspree") {
          res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({
              _subject:
                kind === "order"
                  ? `Order inquiry ${reference} — ${field("name")}`
                  : `Contact message — ${field("name")}`,
              reference,
              type: kind === "order" ? "Order inquiry" : "Contact message",
              name: field("name"),
              email: field("email"),
              phone: field("phone"),
              message: field("message"),
              ...(orderText ? { order: orderText } : {}),
              _gotcha: field("website"),
            }),
          });
        } else {
          res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              kind,
              name: field("name"),
              email: field("email"),
              phone: field("phone"),
              comments: field("message"),
              consent: data.get("consent") === "on",
              website: field("website"),
              startedAt,
              idempotencyKey,
              turnstileToken: String(data.get("cf-turnstile-response") || ""),
              items: items.map(({ productId, buildId, size, quantity }) => ({ productId, buildId, size, quantity })),
            }),
          });
        }
        const body = await res.json().catch(() => ({}));
        if (!res.ok || body.ok === false || (mode === "worker" && !body.ok)) {
          (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
          if (res.status === 400) idempotencyKey = crypto.randomUUID();
          const message =
            typeof body.error === "string"
              ? body.error
              : Array.isArray(body.errors) && body.errors[0]?.message
                ? String(body.errors[0].message)
                : `We couldn't send your message. Please try again or email ${inbox}.`;
          throw new Error(message);
        }
        saveReceipt(
          mode === "worker" ? String(body.reference) : reference,
          mode === "worker" ? String(body.receivedAt) : new Date().toISOString(),
          true,
        );
        if (kind === "order") writeCart([]); // only after the message was accepted
        window.location.assign(url("confirmation/"));
      } catch (e) {
        fail(
          e instanceof TypeError
            ? `Network problem — nothing was sent. Please try again or email ${inbox}.`
            : e instanceof Error
              ? e.message
              : "Something went wrong. Please try again.",
        );
      }
    });
    button.disabled = false;
  }
</script>
<style>
  .form-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 2px;
    line-height: 1.6;
  }
  .consent input {
    flex: none;
    margin-top: 2px;
  }
  .consent a {
    text-decoration: underline;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf-turnstile {
    margin: 4px 0 18px;
  }
  .form-foot {
    margin: 12px 0 0;
  }
  input:user-invalid,
  textarea:user-invalid {
    border-color: #a01919;
  }
  @media (max-width: 767px) {
    .form-pair {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
