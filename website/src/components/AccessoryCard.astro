---
import Price from "./Price.astro";
import ProductVisual from "./ProductVisual.astro";
import StatusBadge from "./StatusBadge.astro";
import { url } from "../lib/urls";
import { money } from "../lib/catalog";
import type { Accessory } from "../data/accessories/catalog";
const { item } = Astro.props as { item: Accessory };
const href = url(`accessories/${item.slug}/`);
---

<article class="card" data-category={item.category}>
  <a href={href}>
    <ProductVisual
      image={item.images[0]}
      alt={`Equator ${item.name}`}
      label={item.name}
      class="on-white"
    />
    <h3>{item.name}</h3>
  </a>
  <span class="meta muted">{item.category}</span>
  <p style="margin:14px 0 8px">{item.description}</p>
  <p class="card-price"><Price amount={item.price} /></p>
  <StatusBadge status={item.inventoryStatus} />
  <div><a class="text-link" href={href}>View details</a></div>
</article>
