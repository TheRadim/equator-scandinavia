---
import ProductVisual from "./ProductVisual.astro";
import StatusBadge from "./StatusBadge.astro";
import { url } from "../lib/urls";
import { money, fromPrice } from "../lib/catalog";
import type { Wheel } from "../data/wheels/catalog";
const { wheel } = Astro.props as { wheel: Wheel };
const href = url(`wheels/${wheel.slug}/`);
---

<article class="card" data-category={wheel.category}>
  <a href={href}>
    <ProductVisual
      image={wheel.images[0]}
      alt={`Equator ${wheel.name} carbon wheelset`}
      label={wheel.depthLabel}
      sublabel="mm rim depth"
    />
    <h3>{wheel.name} <span aria-hidden="true" style="float:right">↗</span></h3>
  </a>
  <span class="meta muted">{wheel.intendedUse}</span>
  <p style="margin:14px 0 8px">{wheel.description}</p>
  <p class="card-price">
    {wheel.price !== null ? money(wheel.price) : fromPrice(wheel.referenceFrom)}
  </p>
  <StatusBadge status={wheel.inventoryStatus} />
  <div><a class="text-link" href={href}>View wheelset</a></div>
</article>
