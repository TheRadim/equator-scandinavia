---
/** Product gallery: main photo + thumbnail buttons. No hover dependence. */
import ProductVisual from "./ProductVisual.astro";
import { url } from "../lib/urls";
interface Props {
  images: string[];
  alt: string;
  label: string;
  sublabel?: string;
  caption?: string;
}
const { images, alt, label, sublabel, caption } = Astro.props;
---

<div class="gallery" data-gallery>
  <ProductVisual
    image={images[0]}
    alt={alt}
    label={label}
    sublabel={sublabel}
    eager
    class="gallery-main"
  />
  {
    images.length > 1 && (
      <div class="gallery-thumbs" role="group" aria-label="Product photographs">
        {images.map((src, i) => (
          <button
            type="button"
            data-src={url(src)}
            aria-label={`Show photograph ${i + 1} of ${images.length}`}
            aria-pressed={i === 0}
          >
            <picture>
              <source type="image/webp" srcset={url(src.replace(/\.(jpe?g|png)$/i, "-640.webp"))} />
              <img src={url(src)} alt="" width="160" height="120" loading="lazy" decoding="async" />
            </picture>
          </button>
        ))}
      </div>
    )
  }
  {caption && <p class="caption">{caption}</p>}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((g) => {
    const main = g.querySelector<HTMLImageElement>("img.gallery-main");
    main?.addEventListener("load", () =>
      main.classList.toggle("portrait", main.naturalHeight > main.naturalWidth * 0.9),
    );
    g.querySelectorAll<HTMLButtonElement>("[data-src]").forEach((b) =>
      b.addEventListener("click", () => {
        if (main && b.getAttribute("aria-pressed") !== "true") {
          // Short crossfade so the photo doesn't jump: fade out, swap, fade in on load.
          main.classList.add("swapping");
          window.setTimeout(() => {
            main.addEventListener("load", () => main.classList.remove("swapping"), { once: true });
            main.src = b.dataset.src!;
            const source = main.parentElement?.querySelector("source");
            const base = b.dataset.src!.replace(/\.(jpe?g|png)$/i, "");
            if (source) source.srcset = `${base}-640.webp 640w, ${base}-1024.webp 1024w`;
            if (main.complete) main.classList.remove("swapping");
          }, 160);
        }
        g.querySelectorAll("[data-src]").forEach((x) =>
          x.setAttribute("aria-pressed", String(x === b)),
        );
      }),
    );
  });
</script>
