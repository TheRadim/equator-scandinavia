---
import type { InventoryStatus } from "../lib/publication";
const { status } = Astro.props as { status: InventoryStatus };
const tone =
  status === "In stock"
    ? "ok"
    : status === "Available to order"
      ? "order"
      : status === "Out of stock"
        ? "out"
        : "unknown";
const label =
  status === "Out of stock"
    ? "Restocking"
    : status === "Available to order"
      ? "Made to order"
      : status === "Availability unconfirmed"
        ? "Ask for availability"
        : status;
---

<span class={`status-badge ${tone}`}><span aria-hidden="true"></span>{label}</span>
