---
import type { InventoryStatus } from "../lib/publication";
import { statusLabel, statusTone } from "../lib/status";
const { status, source } = Astro.props as { status: InventoryStatus; source?: string };
---

<span class={`status-badge ${statusTone(status)}`} data-stock-src={source}><span aria-hidden="true"></span><span data-stock-label>{statusLabel(status)}</span></span>
