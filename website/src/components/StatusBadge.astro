---
import type { InventoryStatus } from "../lib/publication";
const { status } = Astro.props as { status: InventoryStatus };
const tone =
  status === "In stock"
    ? "ok"
    : status === "Available to order"
      ? "order"
      : status === "Out of stock"
        ? "out"
        : "unknown";
---

<span class={`status-badge ${tone}`}><span aria-hidden="true"></span>{status}</span>
