---
import { url } from "../lib/urls";
const { product } = Astro.props;
---

<article class="card">
  <a href={url(`bikes/${product.slug}/`)}>
    <img
      class="product-image"
      src={url(product.image)}
      alt={`${product.name} titanium bicycle; illustrative complete build`}
      width="1024"
      height="768"
      loading="lazy"
    />
    <h3>
      {product.name}{" "}
      <span aria-hidden="true" style="float:right">
        ↗
      </span>
    </h3>
  </a>
  <span class="meta muted">{product.category}</span>
  <p style="margin:16px 0">{product.description}</p>
  <a class="text-link" href={url(`bikes/${product.slug}/`)}>
    Explore {product.name}
  </a>
</article>
