---
import { url } from "../lib/urls";
import Photo from "./Photo.astro";
import { fromPrice } from "../lib/catalog";
import type { Product } from "../data/bikes/catalog";
const { product } = Astro.props as { product: Product };
const prices = product.builds
  .map((b) => b.price)
  .filter((p): p is number => p !== null);
const from = prices.length ? Math.min(...prices) : null;
const href = url(`bikes/${product.slug}/`);
---

<article class="card ratio-wide">
  <a href={href}>
    <Photo
      class="product-image"
      src={product.image}
      alt={`Equator ${product.name} titanium bicycle; illustrative complete build`}
      sizes="(max-width: 767px) 100vw, 33vw"
    />
    <h3>
      {product.name}
      <span aria-hidden="true" style="float:right">↗</span>
    </h3>
  </a>
  <span class="meta muted">{product.category}</span>
  <p style="margin:14px 0 8px">{product.description}</p>
  <p class="card-price">
    {fromPrice(from, "Frameset from")}
  </p>
  <a class="text-link" href={href}>View bike</a>
</article>
